{
  "name": "magnasirgas7",
  "version": "1.0.0",
  "description": "aplicación de escritorio que permitira realizar las funciones ya realizadas en el magna pro 5 y adicionar las nuevas que se han venido trabajando",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "build": "electron-packager . --all",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Mayra Yesenia Cadena Blanco <mayehero@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "main.js",
      "package.json", 
      "src/db/**/*",
      "src/data/**/*"
    ],
    "appId": "magnasirgas7",
    "productName": "Magna Sirgas 7",
    "asar": true,
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "src/img/logo.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "src/img/logo2.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "icon": "src/img/logo.icns",
      "target": "dmg"
    }
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@turf/turf": "^7.1.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "decimal.js": "^10.4.3",
    "ejs-electron": "^3.0.0",
    "electron-packager": "^17.1.2",
    "electron-reload": "^2.0.0-alpha.1",
    "express": "^4.21.1",
    "leaflet": "^1.9.4",
    "leaflet-providers": "^2.0.0",
    "proj4": "^2.6.2",
    "proj4leaflet": "^1.0.2",
    "rbush": "^4.0.1",
    "shpjs": "^6.1.0",
    "sqlite3": "^5.1.7",
    "topojson-client": "^3.1.0"
  }
}