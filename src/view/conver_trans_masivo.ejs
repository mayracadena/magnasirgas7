<!-- ===================== SCRIPT PARA PROCESAR EL CSV (SIN BOTÓN PROCESAR) ===================== -->
<script>
  // Referencias
  const archivoInput      = document.getElementById('archivo-coordenadas');
  const archivoDetalles   = document.getElementById('archivo-detalles');
  const nombreArchivo     = document.getElementById('nombre-archivo');
  const tamañoArchivo     = document.getElementById('tamaño-archivo');

  const refOrigenRadios   = document.getElementsByName('sistemaRefOrigen');
  const refDestinoRadios  = document.getElementsByName('sistemaRefDestino');
  const coordOrigenRadios = document.getElementsByName('sistemaCoordOrigen');
  const coordDestinoRadios= document.getElementsByName('sistemaCoordDestino');

  const calcularBtn       = document.getElementById('calcular_trans_cover');
  const limpiarBtn        = document.getElementById('limpiarBtn');

  // Almacena las líneas del CSV
  let lineasCSV = [];

  // Al cambiar el archivo en el input, se procesa automáticamente
  archivoInput.addEventListener('change', () => {
    const archivo = archivoInput.files[0];
    if (!archivo) {
      alert('Por favor, selecciona un archivo CSV.');
      return;
    }
    // Mostrar detalles
    archivoDetalles.style.display = 'block';
    nombreArchivo.textContent = `Archivo: ${archivo.name}`;
    tamañoArchivo.textContent = `Tamaño: ${(archivo.size / 1024).toFixed(2)} KB`;

    // Leer
    const reader = new FileReader();
    reader.onload = e => {
      const contenido = e.target.result;
      console.log('Contenido CSV:\n', contenido);
      // Guardar (o procesar) en lineasCSV
      lineasCSV = contenido
        .split('\n')
        .map(l => l.trim())
        .filter(l => l.length > 0);
    };
    reader.readAsText(archivo);
  });

  // Helper para obtener radio seleccionado
  function getSelectedValue(radioNodeList) {
    for (let radio of radioNodeList) {
      if (radio.checked) return radio.value;
    }
    return null;
  }

  // Calcular/Transformar
  calcularBtn.addEventListener('click', () => {
    if (lineasCSV.length < 2) {
      alert('No hay datos suficientes o el CSV está vacío.');
      return;
    }
    const refOrigen   = getSelectedValue(refOrigenRadios);
    const refDestino  = getSelectedValue(refDestinoRadios);
    const coordOrigen = getSelectedValue(coordOrigenRadios);
    const coordDestino= getSelectedValue(coordDestinoRadios);

    alert(`Transformar ${lineasCSV.length - 1} filas
      Ref.Origen: ${refOrigen}, Coord.Origen: ${coordOrigen}
      Ref.Destino: ${refDestino}, Coord.Destino: ${coordDestino}`);
    // Aquí tu lógica real de transformación...
  });

  // Limpiar
  limpiarBtn.addEventListener('click', () => {
    archivoDetalles.style.display = 'none';
    nombreArchivo.textContent = '';
    tamañoArchivo.textContent = '';
    lineasCSV = [];

    archivoInput.value = '';

    // Reiniciamos radios a la primera opción
    if (refOrigenRadios.length)    refOrigenRadios[0].checked    = true;
    if (refDestinoRadios.length)   refDestinoRadios[0].checked   = true;
    if (coordOrigenRadios.length)  coordOrigenRadios[0].checked  = true;
    if (coordDestinoRadios.length) coordDestinoRadios[0].checked = true;

    console.log('Interfaz limpiada.');
  });

  // Si usas OL / Leaflet (opcional)
  window.register = ol.proj.proj4.register;
  window.transform = ol.proj.transform;
</script>

