<%- include('./partials/cabecero.ejs', {"titulo": "ITRF" }); %>
<%- include('./partials/menu.ejs'); %>

<style>
    /* Variables de raíz */
    :root {
      --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
      --primary-color: #00d4ff;
      --secondary-color: #001f3f;
      --secondary-hover-color: #0056b3;
      --text-color: #ffffff;
      --text-muted-color: rgba(255, 255, 255, 0.5);
      --bg-translucent: rgba(255, 255, 255, 0.05);
      --border-color-light: rgba(255, 255, 255, 0.1);
      --border-color-regular: rgba(255, 255, 255, 0.2);
      --focus-bg-color: rgba(255, 255, 255, 0.2);
      --form-control-bg-color: rgba(255, 255, 255, 0.1);
      --card-header-bg-color: rgba(0, 31, 63, 0.8);
      --btn-secondary-bg-color: #555555;
      --btn-secondary-hover-bg-color: #777777;
      --panel-bg-color: rgba(255, 255, 255, 0.05);
      --panel-border-color: rgba(255, 255, 255, 0.1);
      --btn-secondary-text-color: #faffff;
    }
  
    /* Estilos globales */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--main-bg-color);
      color: var(--text-color);
      overflow: hidden;
      height: 100vh;
    }
  
    /* Fondo de partículas */
    #particles-js {
      position: absolute;
      width: 100%;
      height: 100%;
      z-index: -1;
    }
    
    /* Estilos de video de introducción */
    #introVideo {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgb(0, 0, 0);
        z-index: 1000;
    }
  
    /* Contenido principal oculto inicialmente */
    .main-content {
        display: none;
        margin-left: 300px; /* Espacio para la barra lateral */
        flex: 1;
        display: flex;
        flex-direction: column;
        max-height: 80vh;
        overflow-y: auto;
        padding: 20px;
        background: var(--bg-translucent);
        z-index: 1;
    }
  
    /* Estilos de tarjeta */
    .card { 
      background: transparent;
      border: none;
    }
  
    .card-header {
      position: sticky;
      top: 0;
      width: 100%;
      background: var(--card-header-bg-color);
      color: var(--primary-color);
      text-align: center;
      z-index: 10;
      padding: 15px;
      border-bottom: 1px solid var(--border-color-regular);
    }
  
    .card-body {
      padding: 30px;
    }
  
    /* Estilos de formulario */
    .form-group label {
      font-weight: bold;
      color: var(--primary-color);
    }
  
    .form-control {
      background: var(--form-control-bg-color);
      border: 1px solid var(--border-color-regular);
      color: var(--text-color);
    }
  
    .form-control::placeholder {
      color: var(--text-muted-color);
    }
  
    .form-control:focus {
      background: var(--focus-bg-color);
      color: var(--text-color);
    }
  
    /* Botones */
    .btn {
      border: none;
      transition: background-color 0.3s, transform 0.3s;
    }
  
    .btn:hover {
      transform: translateY(-2px);
    }
  
    .btn-primary {
      background-color: var(--secondary-color);
      color: var(--primary-color);
    }
  
    .btn-primary:hover {
      background-color: var(--secondary-hover-color);
    }
  
    .btn-secondary {
      background-color: var(--btn-secondary-bg-color);
      color: var(--btn-secondary-text-color);
    }
  
    .btn-secondary:hover {
      background-color: var(--btn-secondary-hover-bg-color);
    }
  
    /* Paneles */
    .panel {
      background: var(--panel-bg-color);
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 10px;
      border: 1px solid var(--panel-border-color);
    }
  
    .panel h2,
    .panel h3 {
      margin-bottom: 20px;
      color: var(--primary-color);
    }
  
    /* Pestañas */
    .nav-tabs .nav-link {
      background: transparent;
      border: none;
      color: var(--primary-color);
      font-weight: bold;
      transition: color 0.3s, border-bottom 0.3s;
    }
  
    .nav-tabs .nav-link.active {
      color: #000000;
      border-bottom: 2px solid var(--primary-color);
    }
  
    .nav-tabs .nav-link:hover {
      color: var(--text-color);
    }
  
    /* Personalización de partículas */
    .particles-js-canvas-el {
      position: absolute;
      top: 0;
      left: 0;
    }
</style>
</head>
<body>
<div id="particles-js"></div>


<!-- Contenedor principal de contenido -->
<div id="mainContent" class="main-content">
    <div class="card shadow">
        <div class="card-header">
            <h4>MAGNA SIRGAS PRO VII</h4>
        </div>
        <!-- Aquí puedes añadir el contenido adicional que necesites -->
    </div>
</div>

<!-- Particles.js Script -->
<script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
<script>
  particlesJS('particles-js', {
    particles: {
      number: { value: 80 },
      color: { value: '#00d4ff' },
      shape: {
        type: 'circle',
        stroke: { width: 0, color: '#000000' },
        polygon: { nb_sides: 5 },
      },
      opacity: { value: 0.5 },
      size: { value: 3 },
      line_linked: {
        enable: true,
        distance: 150,
        color: '#00d4ff',
        opacity: 0.4,
        width: 1
      },
      move: {
        enable: true,
        speed: 2,
        direction: 'none',
        random: false,
        straight: false,
        out_mode: 'out',
        bounce: false,
      }
    },
    interactivity: {
      detect_on: 'canvas',
      events: {
        onhover: { enable: true, mode: 'grab' },
        onclick: { enable: true, mode: 'push' },
        resize: true
      },
      modes: {
        grab: { distance: 200, line_linked: { opacity: 1 } },
        bubble: { distance: 200, size: 40, duration: 2, opacity: 8 },
        repulse: { distance: 100 },
        push: { particles_nb: 4 },
        remove: { particles_nb: 2 }
      }
    },
    retina_detect: true
  });

  function showMainContent() {
      document.getElementById("introVideo").style.display = "none"; // Oculta el video
      document.getElementById("mainContent").style.display = "block"; // Muestra el contenido principal
  }
</script>

</body>
<%- include('./partials/pie.ejs'); %>
