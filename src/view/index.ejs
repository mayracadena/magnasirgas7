<%- include('./partials/cabecero.ejs', {"titulo": "MAGNA SIRGAS PRO 7" }); %>
<%- include('./partials/menu.ejs'); %>

<style>
  :root {
    --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
    --primary-color: #00d4ff;
    --secondary-color: #001f3f;
    --text-color: #ffffff;
  }
 
  body {
    margin: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: var(--main-bg-color);
    color: var(--text-color);
    overflow: hidden;
  }

  #particles-js {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .main-content {
    margin-left: 300px;
    padding: 20px;
  }

  .title {
    text-align: center;
    color: var(--primary-color);
    margin-bottom: 20px;
  }

  /* Contenedor principal con Flexbox */
  .content-container {
    display: flex;
    gap: 20px;
  }

  /* Panel de coordenadas (izquierda) */
  .panel {
    background: rgba(255, 255, 255, 0.05);
    padding: 20px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    flex: 1;
  }

  .form-control {
    background: rgba(253, 251, 251, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-color);
  }

  .form-control:focus {
    background: rgba(251, 248, 248, 0.15);
    color: var(--text-color);
  }
  .form-control::placeholder {
  color: #ffffff; /* Cambia el color del placeholder a blanco */
  opacity: 1;
}

.form-control:focus::placeholder {
  color: #ffffff; /* Mantiene el color blanco al enfocarse */
}

/* Compatibilidad adicional */
:-ms-input-placeholder {
  color: #ffffff;
}

::-ms-input-placeholder {
  color: #ffffff;
}
  .btn {
    border: none;
    transition: all 0.3s ease;
  }

  .btn-primary:hover {
    background-color: var(--secondary-color);
  }

  /* Sección derecha con el mapa y puntos base */
  .right-section {
    display: flex;
    flex-direction: column;
    flex: 2;
  }

      #map {
    height: 400px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    margin-bottom: 10px;
    border-radius: 15px; /* Esquinas redondeadas */
    overflow: hidden; /* Asegura que el contenido dentro del mapa también respete las esquinas redondeadas */
  }


  .puntos-base-container {
    max-height: 200px; /* Altura máxima del contenedor */
    overflow-y: auto; /* Habilitar barra deslizante */
    background: rgba(255, 255, 255, 0.05);
    padding: 10px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    
  }
</style>
</head>
<body>
<div id="particles-js"></div>


<!-- Contenedor principal de contenido -->
<div id="mainContent" class="main-content">
    <div class="panel">
        <div class="card-header">
            <h4>MAGNA SIRGAS PRO 7</h4>
        </div>
        <!-- Aquí puedes añadir el contenido adicional que necesites -->
    </div>
</div>

<!-- Particles.js Script -->
<script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
<script>
   // Fondo interactivo de partículas
 
   particlesJS('particles-js', {
    particles: {
      number: { value: 150 },
      color: { value: '#00d4ff' },
      shape: { type: 'circle' },
      opacity: { value: 0.5 },
      size: { value: 3 },
      line_linked: {
        enable: true,
        distance: 200,
        color: '#00d4ff',
        opacity: 0.4,
        width: 1
      },
      move: {
        enable: true,
        speed: 2
      }
    },
    interactivity: {
      events: {
        onhover: { enable: true, mode: 'grab' },
        onclick: { enable: true, mode: 'push' }
      },
      modes: {
        grab: { distance: 200, line_linked: { opacity: 1 } }
      }
    },
    retina_detect: true
  });

  function showMainContent() {
      document.getElementById("introVideo").style.display = "none"; // Oculta el video
      document.getElementById("mainContent").style.display = "block"; // Muestra el contenido principal
  }
</script>

</body>
<%- include('./partials/pie.ejs'); %>
