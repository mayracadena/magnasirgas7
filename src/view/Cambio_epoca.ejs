<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interfaz de Cálculo Geodésico</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Variables de raíz */
    :root {
      --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
      --primary-color: #00d4ff;
      --secondary-color: #001f3f;
      --secondary-hover-color: #0056b3;
      --text-color: #ffffff;
      --text-muted-color: rgba(255, 255, 255, 0.5);
      --bg-translucent: rgba(255, 255, 255, 0.05);
      --border-color-light: rgba(255, 255, 255, 0.1);
      --border-color-regular: rgba(255, 255, 255, 0.2);
      --focus-bg-color: rgba(255, 255, 255, 0.2);
      --form-control-bg-color: rgba(255, 255, 255, 0.1);
      --card-header-bg-color: rgba(0, 31, 63, 0.8);
      --btn-secondary-bg-color: #555555;
      --btn-secondary-hover-bg-color: #777777;
      --panel-bg-color: rgba(255, 255, 255, 0.05);
      --panel-border-color: rgba(255, 255, 255, 0.1);
      --btn-secondary-text-color: #faffff;
    }
  
    /* Estilos globales */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--main-bg-color);
      color: var(--text-color);
      overflow: hidden;
      height: 100vh;
    }
  
    /* Fondo de partículas */
    #particles-js {
      position: absolute;
      width: 100%;
      height: 100%;
      z-index: -1;
    }
  .main-container {
    display: flex;
  
    width: 100vw; /* Ancho completo de la ventana */
    overflow: hidden; /* Evita que el contenedor principal tenga desplazamiento */
  }
  
  /* Barra lateral */
  .sidebar {
    width: 250px; /* Ajusta el ancho según tu diseño */
    background-color: #0056b3; /* Color de fondo de la barra lateral */
    overflow-y: auto; /* Agrega desplazamiento en la barra lateral si es necesario */
  }
  /* Contenido principal */
  .main-content {
    flex: 1; /* Ocupa el espacio restante a la derecha de la barra lateral */
    display: flex;
    margin-left: 300px;
    flex-direction: column;
    max-height: 100vh; /* Limita la altura del contenido principal a la ventana */
    overflow-y: auto; /* Permite el desplazamiento vertical si el contenido es mayor */
    padding: 20px;
    background: var(--bg-translucent);
  }
  
  
    /* Estilos de tarjeta */
    .card { 
      background: transparent;
      border: none;
    }
  
    .card-header {
      position: sticky;
      top: 0;
      width: 100%;
      background: var(--card-header-bg-color);
      color: var(--primary-color);
      text-align: center;
      z-index: 10;
      padding: 15px;
      border-bottom: 1px solid var(--border-color-regular);
    }
  
    .card-body {
      padding: 30px;
    }
  
    /* Estilos de formulario */
    .form-group label {
      font-weight: bold;
      color: var(--primary-color);
    }
  
    .form-control {
      background: var(--form-control-bg-color);
      border: 1px solid var(--border-color-regular);
      color: var(--text-color);
    }
  
    .form-control::placeholder {
      color: var(--text-muted-color);
    }
  
    .form-control:focus {
      background: var(--focus-bg-color);
      color: var(--text-color);
    }
  
    /* Botones */
    .btn {
      border: none;
      transition: background-color 0.3s, transform 0.3s;
    }
  
    .btn:hover {
      transform: translateY(-2px);
    }
  
    .btn-primary {
      background-color: var(--secondary-color);
      color: var(--primary-color);
    }
  
    .btn-primary:hover {
      background-color: var(--secondary-hover-color);
    }
  
    .btn-secondary {
      background-color: var(--btn-secondary-bg-color);
      color: var(--btn-secondary-text-color);
    }
  
    .btn-secondary:hover {
      background-color: var(--btn-secondary-hover-bg-color);
    }
  
    /* Paneles */
    .panel {
      background: var(--panel-bg-color);
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 10px;
      border: 1px solid var(--panel-border-color);
    }
  
    .panel h2,
    .panel h3 {
      margin-bottom: 20px;
      color: var(--primary-color);
    }
  
    /* Pestañas */
    .nav-tabs .nav-link {
      background: transparent;
      border: none;
      color: var(--primary-color);
      font-weight: bold;
      transition: color 0.3s, border-bottom 0.3s;
    }
  
    .nav-tabs .nav-link.active {
      color: #000000;
      border-bottom: 2px solid var(--primary-color);
    }
  
    .nav-tabs .nav-link:hover {
      color: var(--text-color);
    }
  
    /* Personalización de partículas */
    .particles-js-canvas-el {
      position: absolute;
      top: 0;
      left: 0;
    }
  
    /* Consultas de medios */
    @media (max-width: 768px) {
      .row {
        flex-direction: column;
      }
      .row .col {
        margin-bottom: 15px;
      }
    }
  </style>
</head>
<body>
  <div class="main-content" >
  <div class="card shadow">
  <div id="particles-js"></div>
  <div class="main-card card shadow">
    <div class="card-header">
      <h2>Cambio de Época</h2>
    </div>
    <div class="card-body">
      <nav>
        <div class="nav nav-tabs" id="nav-tab" role="tablist">
          <button class="nav-link active" id="panel_directo_tab" data-bs-toggle="tab"
                  data-bs-target="#panel_directo" type="button" role="tab" aria-controls="panel_directo"
                  aria-selected="true">Individual</button>
          <button class="nav-link" id="panel_inverso_tab" data-bs-toggle="tab"
                  data-bs-target="#panel_inverso" type="button" role="tab" aria-controls="panel_inverso"
                  aria-selected="false">Archivo</button>
        </div>
      </nav>

      <div class="tab-content mt-4" id="nav-tabContent">
        <!-- Panel Individual -->
        <div class="tab-pane fade show active" id="panel_directo" role="tabpanel" aria-labelledby="panel_directo_tab">
          <div class="container-fluid">
            <!-- Fila para Época de Rastreo y Época de Referencia -->
            <div class="row mt-3">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="fechaRastreoPartida">Época de Rastreo</label>
                  <input type="date" class="form-control" id="fechaRastreoPartida">
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <label for="fechaReferenciaPartida">Época de Referencia</label>
                  <input type="date" class="form-control" id="fechaReferenciaPartida">
                </div>
              </div>
            </div>

            <!-- Fila para Modelo de Velocidades e Información -->
            <div class="row mt-3">
              <div class="col-md-6">
                <div class="form-group">
                  <label for="modeloVelocidadesPartida">Modelo de Velocidades</label>
                  <select class="form-control" id="modeloVelocidadesPartida" onchange="mostrarInformacionVemos()">
                    <option value="vemos2022">VEMOS 2022</option>
                    <option value="vemos2017">VEMOS 2017</option>
                    <option value="vemos2015">VEMOS 2015</option>
                    <option value="vemos2009">VEMOS 2009</option>
                  </select>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group">
                  <label>Información del Modelo de Velocidades</label>
                  <div id="informacionVemos" class="p-2 bg-light text-dark rounded">
                    Cada modelo de velocidades es válido para un lapso de tiempo determinado.
                  </div>
                </div>
              </div>
            </div>

            <!-- Fila para Tipo de Coordenada de Partida -->
            <div class="row mt-3">
              <div class="col-md-12">
                <label>Tipo de Coordenada de Partida</label>
                <ul class="nav nav-tabs" id="myTabPartida" role="tablist">
                  <li class="nav-item">
                    <button class="nav-link active" id="elipsoidal-tab-partida" data-bs-toggle="tab" data-bs-target="#elipsoidal-partida" type="button" role="tab" aria-controls="elipsoidal-partida" aria-selected="true">Elipsoidal Sexagesimal</button>
                  </li>
                  <li class="nav-item">
                    <button class="nav-link" id="elipsoidal-decimal-tab-partida" data-bs-toggle="tab" data-bs-target="#elipsoidal-decimal-partida" type="button" role="tab" aria-controls="elipsoidal-decimal-partida" aria-selected="false">Elipsoidal Decimal</button>
                  </li>
                  <!-- Agrega las otras pestañas según sea necesario -->
                </ul>
                <div class="tab-content mt-2" id="myTabContentPartida">
                  <div class="tab-pane fade show active" id="elipsoidal-partida" role="tabpanel" aria-labelledby="elipsoidal-tab-partida">
                    <div class="form-group mt-3">
                      <label for="latitud-partida">Latitud</label>
                      <input type="text" class="form-control" id="latitud-partida" placeholder="GG.MM.SS">
                    </div>
                    <div class="form-group mt-3">
                      <label for="longitud-partida">Longitud</label>
                      <input type="text" class="form-control" id="longitud-partida" placeholder="GG.MM.SS">
                    </div>
                  </div>
                  <div class="tab-pane fade" id="elipsoidal-decimal-partida" role="tabpanel" aria-labelledby="elipsoidal-decimal-tab-partida">
                    <div class="form-group mt-3">
                      <label for="latitud-partida-decimal">Latitud Decimal</label>
                      <input type="text" class="form-control" id="latitud-partida-decimal" placeholder="Decimal">
                    </div>
                    <div class="form-group mt-3">
                      <label for="longitud-partida-decimal">Longitud Decimal</label>
                      <input type="text" class="form-control" id="longitud-partida-decimal" placeholder="Decimal">
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Botones de Acción -->
            <div class="row mt-4">
              <div class="col text-center">
                <button class="btn btn-primary" onclick="procesarArchivo()">Calcular</button>
                <button class="btn btn-secondary" onclick="limpiarFormulario()">Limpiar</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel Archivo -->
        <div class="tab-pane fade" id="panel_inverso" role="tabpanel" aria-labelledby="panel_inverso_tab">
          <div class="container-fluid">
            <!-- Similar estructura del panel "Archivo" aquí -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- JavaScript para Particles.js y Bootstrap -->
  <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    particlesJS('particles-js', {
      particles: {
        number: { value: 80 },
        color: { value: '#00d4ff' },
        shape: {
          type: 'circle',
          stroke: { width: 0, color: '#000000' },
          polygon: { nb_sides: 5 },
        },
        opacity: { value: 0.5 },
        size: { value: 3 },
        line_linked: {
          enable: true,
          distance: 150,
          color: '#00d4ff',
          opacity: 0.4,
          width: 1
        },
        move: {
          enable: true,
          speed: 2,
          direction: 'none',
          random: false,
          straight: false,
          out_mode: 'out',
          bounce: false,
        }
      },
      interactivity: {
        detect_on: 'canvas',
        events: {
          onhover: { enable: true, mode: 'grab' },
          onclick: { enable: true, mode: 'push' },
          resize: true
        },
        modes: {
          grab: { distance: 200, line_linked: { opacity: 1 } },
          bubble: { distance: 200, size: 40, duration: 2, opacity: 8 },
          repulse: { distance: 100 },
          push: { particles_nb: 4 },
          remove: { particles_nb: 2 }
        }
      },
      retina_detect: true
    });

    function mostrarInformacionVemos() {
      var seleccion = document.getElementById("modeloVelocidadesPartida").value;
      var informacionVemos = document.getElementById("informacionVemos");

      // Limpia el contenido actual
      informacionVemos.innerHTML = "";

      // Información según el modelo seleccionado
      if (seleccion === "vemos2022") {
        informacionVemos.innerHTML = 
          '<p><strong>VEMOS 2022:</strong> Cubre el periodo comprendido entre el 1 de febrero de 2017 y el 30 de abril de 2022.</p>';
      } else if (seleccion === "vemos2017") {
        informacionVemos.innerHTML = 
          '<p><strong>VEMOS 2017:</strong> Cubre la región comprendida entre 120°W, 55°S y 35°W, 32°N con una resolución espacial de 1° x 1°. La incertidumbre promedio es ±1.0 mm/a en la dirección norte-sur y ±1.7 mm/a en la dirección este-oeste.</p>';
      } else if (seleccion === "vemos2015") {
        informacionVemos.innerHTML = 
          '<p><strong>VEMOS 2015:</strong> Válido del 14 de marzo de 2010 al 11 de abril del 2015. La incertidumbre media es ±0.6 mm/a en la dirección norte-sur y ±1.2 mm/a en la dirección este-oeste.</p>';
      } else if (seleccion === "vemos2009") {
        informacionVemos.innerHTML = 
          '<p><strong>VEMOS 2009:</strong> Válido para el periodo entre enero 2 de 2000 y junio 30 de 2009. La incertidumbre media es aproximadamente 1.5 mm/a.</p>';
      }
    }

    document.addEventListener("DOMContentLoaded", function() {
      mostrarInformacionVemos();
    });
  </script>
</body>
</html>


