<%- include('./partials/cabecero.ejs', {"titulo": "ITRF" }); %>
<%- include('./partials/menu.ejs'); %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interfaz de Cálculo Geodésico</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      padding: 20px;
    }
    .card {
      margin-bottom: 20px;
    }
    .form-control {
      margin-bottom: 10px;
    }
    .form-group {
      margin-bottom: 15px;
    }
    .nav-tabs .nav-link {
      background-color: #e9ecef;
      color: #495057;
      border: 1px solid #dee2e6;
    }
    .nav-tabs .nav-link.active {
      background-color: #fff;
      color: #000;
    }
  </style>
</head>
<body>

<div class="container">
  <!-- Sistema de Referencia de Partida -->
  <div class="card">
    <div class="card-header">
      Sistema de Referencia Partida
    </div>
    <div class="card-body">
      <div class="form-group">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="sistemaPartida" id="magnaSIRGAS" checked>
          <label class="form-check-label" for="magnaSIRGAS">MAGNA-SIRGAS</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="sistemaPartida" id="datumBogota">
          <label class="form-check-label" for="datumBogota">Datum Bogotá</label>
        </div>
      </div>
      <div class="form-group">
        <label for="fechaRastreo">Fecha de Rastreo:</label>
        <input type="date" class="form-control" id="fechaRastreo">
      </div>
      <div class="form-group">
        <label for="modeloVelocidades">Modelo Velocidades:</label>
        <select class="form-control" id="modeloVelocidades">
          <option>VEMOS 2017</option>
          <option>VEMOS 2015</option>
          <option>VEMOS 2009</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Sistema de Referencia de Destino -->
  <div class="card">
    <div class="card-header">
      Sistema de Referencia Destino
    </div>
    <div class="card-body">
      <div class="form-group">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="sistemaDestino" id="magnaSIRGASDestino" checked>
          <label class="form-check-label" for="magnaSIRGASDestino">MAGNA-SIRGAS</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="sistemaDestino" id="datumBogotaDestino">
          <label class="form-check-label" for="datumBogotaDestino">Datum Bogotá</label>
        </div>
      </div>
      <div class="form-group">
        <label for="fechaReferencia">Fecha de Referencia:</label>
        <input type="date" class="form-control" id="fechaReferencia">
      </div>
    </div>
  </div>

  <!-- Panel de Coordenadas -->
  <div class="card">
    <div class="card-header">
      Tipo de Coordenada Partida
    </div>
    <div class="card-body">
      <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
          <a class="nav-link active" id="elipsoidal-tab" data-bs-toggle="tab" href="#elipsoidal" role="tab">Elipsoidal</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" id="utm-tab" data-bs-toggle="tab" href="#utm" role="tab">UTM</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" id="gauss-tab" data-bs-toggle="tab" href="#gauss" role="tab">Gauss Krüger</a>
        </li>
      </ul>
      <div class="tab-content">
        <div class="tab-pane fade show active" id="elipsoidal" role="tabpanel">
          <div class="form-group">
            <label>Latitud:</label>
            <input type="text" class="form-control" placeholder="GG">
            <input type="text" class="form-control" placeholder="MM">
            <input type="text" class="form-control" placeholder="SS.DDDDD">
            <select class="form-control">
              <option>N</option>
              <option>S</option>
            </select>
          </div>
          <div class="form-group">
            <label>Longitud:</label>
            <input type="text" class="form-control" placeholder="GG">
            <input type="text" class="form-control" placeholder="MM">
            <input type="text" class="form-control" placeholder="SS.DDDDD">
            <select class="form-control">
              <option>E</option>
              <option>W</option>
            </select>
          </div>
        </div>
        <!-- Otras pestañas de coordenadas aquí -->
      </div>
    </div>
  </div>

  <!-- Botones de Acción -->
  <div class="text-center">
    <button class="btn btn-primary">Calcular</button>
    <button class="btn btn-secondary">Limpiar</button>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
