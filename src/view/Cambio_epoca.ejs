<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Transformación ITRF</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<style>
    /* Variables de raíz */
    :root {
      --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
      --primary-color: #00d4ff;
      --secondary-color: #001f3f;
      --secondary-hover-color: #0056b3;
      --text-color: #ffffff;
      --text-muted-color: rgba(255, 255, 255, 0.5);
      --bg-translucent: rgba(255, 255, 255, 0.05);
      --border-color-light: rgba(255, 255, 255, 0.1);
      --border-color-regular: rgba(255, 255, 255, 0.2);
      --focus-bg-color: rgba(255, 255, 255, 0.2);
      --form-control-bg-color: rgba(255, 255, 255, 0.1);
      --card-header-bg-color: rgba(0, 31, 63, 0.8);
      --btn-secondary-bg-color: #555555;
      --btn-secondary-hover-bg-color: #777777;
      --panel-bg-color: rgba(255, 255, 255, 0.05);
      --panel-border-color: rgba(255, 255, 255, 0.1);
      --btn-secondary-text-color: #faffff;
    }
  
    /* Estilos globales */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--main-bg-color);
      color: var(--text-color);
      overflow: hidden;
      height: 100vh;
    }
  
    /* Fondo de partículas */
    #particles-js {
      position: absolute;
      width: 100%;
      height: 100%;
      z-index: -1;
    }
  
    /* Estilo para la "Tierra" */
    .earth {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 80px;
      height: 80px;
      background: radial-gradient(circle, #001f3f, #000);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      z-index: -1;
    }

    /* Órbitas alrededor de la Tierra */
    .orbit {
      position: absolute;
      top: 50%;
      left: 50%;
      border: 1px dashed rgba(255, 255, 255, 0.2);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      z-index: -2;
    }

    .orbit-1 { width: 150px; height: 150px; animation: rotateOrbit 20s linear infinite; }
    .orbit-2 { width: 200px; height: 200px; animation: rotateOrbit 30s linear infinite; }
    .orbit-3 { width: 250px; height: 250px; animation: rotateOrbit 40s linear infinite; }

    /* Estilo y animación para satélites */
    .satellite {
      width: 6px;
      height: 6px;
      background-color: #00d4ff;
      border-radius: 50%;
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
    }

    /* Animación de rotación de las órbitas */
    @keyframes rotateOrbit {
      0% { transform: rotate(0deg) translate(-50%, -50%); }
      100% { transform: rotate(360deg) translate(-50%, -50%); }
    }
</style>
</head>
<body>

<div class="earth"></div>
<div class="orbit orbit-1"><div class="satellite"></div></div>
<div class="orbit orbit-2"><div class="satellite"></div></div>
<div class="orbit orbit-3"><div class="satellite"></div></div>



<script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
<!-- Particles.js Script -->


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="controller/itrf.js"></script>

