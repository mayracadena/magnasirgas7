<%- include('./partials/cabecero.ejs', {"titulo": "Calculo de velocidades individual" }); %>
<%- include('./partials/menu.ejs'); %>

<style>
  /* Variables de raíz */
  :root {
    --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
    --primary-color: #00d4ff;
    --secondary-color: #001f3f;
    --secondary-hover-color: #0056b3;
    --text-color: #ffffff;
    --text-muted-color: rgba(255, 255, 255, 0.5);
    --bg-translucent: rgba(255, 255, 255, 0.05);
    --border-color-light: rgba(255, 255, 255, 0.1);
    --border-color-regular: rgba(255, 255, 255, 0.2);
    --focus-bg-color: rgba(255, 255, 255, 0.2);
    --form-control-bg-color: rgba(255, 255, 255, 0.1);
    --card-header-bg-color: rgba(0, 31, 63, 0.8);
    --btn-secondary-bg-color: #555555;
    --btn-secondary-hover-bg-color: #777777;
    --panel-bg-color: rgba(255, 255, 255, 0.05);
    --panel-border-color: rgba(255, 255, 255, 0.1);
    --btn-secondary-text-color: #faffff;
  }

  /* Estilos globales */
  body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: var(--main-bg-color);
    color: var(--text-color);
    overflow: hidden;
    height: 100vh;
  }

  /* Fondo de partículas */
  #particles-js {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
.main-container {
  display: flex;

  width: 100vw; /* Ancho completo de la ventana */
  overflow: hidden; /* Evita que el contenedor principal tenga desplazamiento */
}

/* Barra lateral */
.sidebar {
  width: 250px; /* Ajusta el ancho según tu diseño */
  background-color: #0056b3; /* Color de fondo de la barra lateral */
  overflow-y: auto; /* Agrega desplazamiento en la barra lateral si es necesario */
}
/* Contenido principal */
.main-content {
  flex: 1; /* Ocupa el espacio restante a la derecha de la barra lateral */
  display: flex;
  margin-left: 300px;
  flex-direction: column;
  max-height: 100vh; /* Limita la altura del contenido principal a la ventana */
  overflow-y: auto; /* Permite el desplazamiento vertical si el contenido es mayor */
  padding: 20px;
  background: var(--bg-translucent);
}


  /* Estilos de tarjeta */
  .card { 
    background: transparent;
    border: none;
  }

  .card-header {
    position: sticky;
    top: 0;
    width: 100%;
    background: var(--card-header-bg-color);
    color: var(--primary-color);
    text-align: center;
    z-index: 10;
    padding: 15px;
    border-bottom: 1px solid var(--border-color-regular);
  }

  .card-body {
    padding: 30px;
  }

  /* Estilos de formulario */
  .form-group label {
    font-weight: bold;
    color: var(--primary-color);
  }

  .form-control {
    background: var(--form-control-bg-color);
    border: 1px solid var(--border-color-regular);
    color: var(--text-color);
  }

  .form-control::placeholder {
    color: var(--text-muted-color);
  }

  .form-control:focus {
    background: var(--focus-bg-color);
    color: var(--text-color);
  }

  /* Botones */
  .btn {
    border: none;
    transition: background-color 0.3s, transform 0.3s;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background-color: var(--secondary-color);
    color: var(--primary-color);
  }

  .btn-primary:hover {
    background-color: var(--secondary-hover-color);
  }

  .btn-secondary {
    background-color: var(--btn-secondary-bg-color);
    color: var(--btn-secondary-text-color);
  }

  .btn-secondary:hover {
    background-color: var(--btn-secondary-hover-bg-color);
  }

  /* Paneles */
  .panel {
    background: var(--panel-bg-color);
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 10px;
    border: 1px solid var(--panel-border-color);
  }

  .panel h2,
  .panel h3 {
    margin-bottom: 20px;
    color: var(--primary-color);
  }

  /* Pestañas */
  .nav-tabs .nav-link {
    background: transparent;
    border: none;
    color: var(--primary-color);
    font-weight: bold;
    transition: color 0.3s, border-bottom 0.3s;
  }

  .nav-tabs .nav-link.active {
    color: #000000;
    border-bottom: 2px solid var(--primary-color);
  }

  .nav-tabs .nav-link:hover {
    color: var(--text-color);
  }

  /* Personalización de partículas */
  .particles-js-canvas-el {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* Consultas de medios */
  @media (max-width: 768px) {
    .row {
      flex-direction: column;
    }
    .row .col {
      margin-bottom: 15px;
    }
  }
</style>

</head>
<body>
  <!-- Particles Background -->
  <div id="particles-js"></div>

  <!-- Main Content -->
  <div class="main-content" >
    <div class="card shadow">
      <div class="card-header">
        <h4>Cálculo de Velocidades Individual</h4>
      </div>
      <div class="card-body">
        <form id="ondulacionForm">
          <!-- Tipo de Coordenada Panel -->
          <div class="panel">
            <h6>Tipo de Coordenada</h6>
            <ul class="nav nav-tabs" id="myTab" role="tablist">
              <!-- Tab Items -->
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="elipsoidal-tab" data-bs-toggle="tab" data-bs-target="#elipsoidal" type="button" role="tab" aria-controls="elipsoidal" aria-selected="true">Elipsoidal Sexagesimal</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="elipsoidaldecimal-tab" data-bs-toggle="tab" data-bs-target="#coordenadas-decimales" type="button" role="tab" aria-controls="elipsoidaldecimal" aria-selected="false">Elipsoidal Decimal</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="origen-nacional-tab" data-bs-toggle="tab" data-bs-target="#origen-nacional" type="button" role="tab" aria-controls="origen-nacional" aria-selected="false">Origen Nacional</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="geocentrica-tab" data-bs-toggle="tab" data-bs-target="#geocentrica" type="button" role="tab" aria-controls="geocentrica" aria-selected="false">Geocéntrica</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="plana-cartesiana-tab" data-bs-toggle="tab" data-bs-target="#plana-cartesiana" type="button" role="tab" aria-controls="plana-cartesiana" aria-selected="false">Plana Cartesiana</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="utm-tab" data-bs-toggle="tab" data-bs-target="#utm" type="button" role="tab" aria-controls="utm" aria-selected="false">UTM</button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="gauss-kruger-tab" data-bs-toggle="tab" data-bs-target="#gauss-kruger" type="button" role="tab" aria-controls="gauss-kruger" aria-selected="false">Gauss Krüger</button>
              </li>
            </ul>
            <div class="tab-content" id="myTabContent">
              <!-- Elipsoidal Tab Pane -->
              <div class="tab-pane fade show active" id="elipsoidal" role="tabpanel" aria-labelledby="elipsoidal-tab">
                <!-- Latitud Input -->
                <div class="form-group">
                  <label for="latitud">Latitud:</label>
                  <div class="row">
                    <div class="col-md-3">
                      <input type="text" class="form-control" placeholder="GG" id="latitud-grados">
                    </div>
                    <div class="col-md-3">
                      <input type="text" class="form-control" placeholder="MM" id="latitud-minutos">
                    </div>
                    <div class="col-md-3">
                      <input type="text" class="form-control" placeholder="SS.DDDDD" id="latitud-segundos">
                    </div>
                    <div class="col-md-3">
                      <select class="form-control" id="latitud-hemisferio">
                        <option value="N">N</option>
                        <option value="S">S</option>
                      </select>
                    </div>
                  </div>
                </div>
                <!-- Longitud Input -->
                <div class="form-group">
                  <label for="longitud">Longitud:</label>
                  <div class="row">
                    <div class="col-md-3">
                      <input type="text" class="form-control" placeholder="GG" id="longitud-grados">
                    </div>
                    <div class="col-md-3">
                      <input type="text" class="form-control" placeholder="MM" id="longitud-minutos">
                    </div>
                    <div class="col-md-3">
                      <input type="text" class="form-control" placeholder="SS.DDDDD" id="longitud-segundos">
                    </div>
                    <div class="col-md-3">
                      <select class="form-control" id="longitud-hemisferio">
                        <option value="E">E</option>
                        <option value="W">W</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Elipsoidal Decimal Tab Pane -->
              <div class="tab-pane fade" id="coordenadas-decimales" role="tabpanel" aria-labelledby="elipsoidaldecimal-tab">
                <div class="form-group">
                  <label for="latitud-decimal">Latitud (decimal):</label>
                  <input type="text" class="form-control" placeholder="Latitud (decimal)" id="latitud-decimal">
                </div>
                <div class="form-group">
                  <label for="longitud-decimal">Longitud (decimal):</label>
                  <input type="text" class="form-control" placeholder="Longitud (decimal)" id="longitud-decimal">
                </div>
              </div>
              <!-- Origen Nacional Tab Pane -->
              <div class="tab-pane fade" id="origen-nacional" role="tabpanel" aria-labelledby="origen-nacional-tab">
                <div class="form-group">
                  <label for="norte">Norte (m):</label>
                  <input type="text" class="form-control" id="norte">
                </div>
                <div class="form-group">
                  <label for="este">Este (m):</label>
                  <input type="text" class="form-control" id="este">
                </div>
              </div>
              <!-- Geocéntrica Tab Pane -->
              <div class="tab-pane fade" id="geocentrica" role="tabpanel" aria-labelledby="geocentrica-tab">
                <div class="form-group">
                  <label for="x">X (m):</label>
                  <input type="text" class="form-control" id="x">
                </div>
                <div class="form-group">
                  <label for="y">Y (m):</label>
                  <input type="text" class="form-control" id="y">
                </div>
                <div class="form-group">
                  <label for="z">Z (m):</label>
                  <input type="text" class="form-control" id="z">
                </div>
              </div>
              <!-- Plana Cartesiana Tab Pane -->
              <div class="tab-pane fade" id="plana-cartesiana" role="tabpanel" aria-labelledby="plana-cartesiana-tab">
                <div class="form-group">
                  <label for="norte-pc">Norte (m):</label>
                  <input type="text" class="form-control" id="norte-pc">
                </div>
                <div class="form-group">
                  <label for="este-pc">Este (m):</label>
                  <input type="text" class="form-control" id="este-pc">
                </div>
                <p></p> 
                <h6>Origen Cartesiano</h6>
                <div class="form-group">
                  <label for="departamento">Departamento:</label>
                  <select class="form-control" id="departamento">
                    <option value="">--Seleccione Departamento--</option>
                    <option value="amazonas">Amazonas</option>
                    <!-- Agregar más opciones según sea necesario -->
                  </select>
                </div>
                <div class="form-group">
                  <label for="municipio">Municipio:</label>
                  <select class="form-control" id="municipio">
                    <option value="">--Seleccione Municipio--</option>
                    <!-- Opciones dinámicas según el departamento seleccionado -->
                  </select>
                </div>
                <div class="form-group">
                  <label for="origenes-cartesianos">Orígenes Cartesianos Disponibles:</label>
                  <select class="form-control" id="origenes-cartesianos">
                    <!-- Opciones dinámicas según el municipio seleccionado -->
                  </select>
                </div>
              </div>
              <!-- UTM Tab Pane -->
              <div class="tab-pane fade" id="utm" role="tabpanel" aria-labelledby="utm-tab">
                <div class="form-group">
                  <label for="norte-utm">Norte (m):</label>
                  <input type="text" class="form-control" id="norte-utm">
                </div>
                <div class="form-group">
                  <label for="este-utm">Este (m):</label>
                  <input type="text" class="form-control" id="este-utm">
                </div>
                <div class="form-group">
                  <label for="huso">Huso:</label>
                  <input type="text" class="form-control" id="huso">
                </div>
                <div class="form-group">
                  <label for="hemisferio">Hemisferio:</label>
                  <select class="form-control" id="hemisferio">
                    <option value="N">N</option>
                    <option value="S">S</option>
                  </select>
                </div>
              </div>
              <!-- Gauss Krüger Tab Pane -->
              <div class="tab-pane fade" id="gauss-kruger" role="tabpanel" aria-labelledby="gauss-kruger-tab">
                <div class="form-group">
                  <label for="norte-gk">Norte (m):</label>
                  <input type="text" class="form-control" id="norte-gk">
                </div>
                <div class="form-group">
                  <label for="este-gk">Este (m):</label>
                  <input type="text" class="form-control" id="este-gk">
                </div>
                <div class="form-group">
                  <label for="origen-gauss">Origen Gauss:</label>
                  <select class="form-control" id="origen-gauss">
                    <option value="Central">Central</option>
                    <option value="Este">Este</option>
                    <option value="Este-este">Este-este</option>
                    <option value="Insular">Insular</option>
                    <option value="Oeste">Oeste</option>
                    <option value="Oeste-oeste">Oeste-oeste</option>
                  </select>
                </div>
              </div>
            </div>
          </div>  
          <!-- Modelo de Velocidades Panel -->
          <div class="panel">
            <div class="form-group">
              <label for="modelo-velocidades">Seleccione un modelo de velocidades  para realizar el calculo:</label>
              <select class="form-control" id="modelo-velocidades">
                <option value="VEMOS2017">VEMOS 2022</option>
                <option value="VEMOS2017">VEMOS 2017</option>
                <option value="VEMOS2015">VEMOS 2015</option>
                <option value="VEMOS2009">VEMOS 2009</option>
              </select>
            </div>
            <p></p> 
            <h6>Velocidades calculadas</h6>

            <div class="row">
                <!-- Velocidades Norte-Sur y Este-Oeste -->
              <div class="row">
                <div class="col-md-6">
                  <div class="form-group">
                    <label for="velocidad-norte-sur">Velocidad Norte-Sur :</label>
                    <input type="text" class="form-control" id="velocidad-norte-sur" readonly>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="form-group">
                    <label for="velocidad-este-oeste">Velocidad Este-Oeste :</label>
                    <input type="text" class="form-control" id="velocidad-este-oeste" readonly>
                  </div>
                </div>
              </div>
                <div class="col-md-4">
                  <div class="form-group">
                    <label for="velocidad-x">Velocidad X :</label>
                    <input type="text" class="form-control" id="velocidad-x" readonly>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="form-group">
                    <label for="velocidad-y">Velocidad Y :</label>
                    <input type="text" class="form-control" id="velocidad-y" readonly>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="form-group">
                    <label for="velocidad-z">Velocidad Z :</label>
                    <input type="text" class="form-control" id="velocidad-z" readonly>
                  </div>
                </div>
              </div>
              
            </div>
          <!-- Action Buttons -->
          <p></p> 
          <div class="text-center">
            <button id="calcular" class="btn btn-primary"><i class="bi bi-play-circle"></i> Calcular</button>
            <button id="limpiar" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Limpiar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Particles.js Script -->
  <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
  <script>
    particlesJS('particles-js', {
      particles: {
        number: { value: 80 },
        color: { value: '#00d4ff' },
        shape: {
          type: 'circle',
          stroke: { width: 0, color: '#000000' },
          polygon: { nb_sides: 5 },
        },
        opacity: { value: 0.5 },
        size: { value: 3 },
        line_linked: {
          enable: true,
          distance: 150,
          color: '#00d4ff',
          opacity: 0.4,
          width: 1
        },
        move: {
          enable: true,
          speed: 2,
          direction: 'none',
          random: false,
          straight: false,
          out_mode: 'out',
          bounce: false,
        }
      },
      interactivity: {
        detect_on: 'canvas',
        events: {
          onhover: { enable: true, mode: 'grab' },
          onclick: { enable: true, mode: 'push' },
          resize: true
        },
        modes: {
          grab: { distance: 200, line_linked: { opacity: 1 } },
          bubble: { distance: 200, size: 40, duration: 2, opacity: 8 },
          repulse: { distance: 100 },
          push: { particles_nb: 4 },
          remove: { particles_nb: 2 }
        }
      },
      retina_detect: true
    });
  </script>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Custom Script -->
  <script src="controller/velocidades.js"></script>
</body>
</html>
<%- include('./partials/pie.ejs'); %>
