                                <div class="col-md-3">
                                    <input id="long1_mm_i" type="number" class="form-control" placeholder="MM" min="0"
                                        max="60" required>
                                </div>
                                <div class="col-md-3">
                                    <input id="long1_ss_i" type="number" class="form-control" placeholder="SS.SSSS"
                                        step="0.000001" required>
                                </div>
                                <div class="col-md-3">
                                    <select class="input-group-text ">
                                        <option selected value="W">W</option>
