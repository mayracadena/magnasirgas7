                                </div>
                                <div class="col-md-3">
                                    <input id="lat1_mm_i" type="number" class="form-control" placeholder="MM" min="0"
                                        max="60" required>
                                </div>
                                <div class="col-md-3">
                                    <input id="lat1_ss_i" type="number" class="form-control" placeholder="SS.SSSS"
                                        step="0.000001" required>
                                </div>
                                <div class="col-md-3">
                                    <select class="input-group-text "id="hemisferio1_i">
                                        <option selected value="N">N</option>
                                        <option value="S">S</option>
                                    </select>
                                </div>
                            </div>
