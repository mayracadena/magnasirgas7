<%- include('./partials/cabecero.ejs', {"titulo": "Cálculos elipsoidales" }); %>
    <%- include('./partials/menu.ejs'); %>
    
        <div class="card shadow">
            <div class="card-header">
                <h2>Cálculo Problema geodésico</h2>
            </div>
            <div class="card-body">

                <nav>
                    <div class="nav nav-tabs" id="nav-tab" role="tablist">
                        <button class="nav-link active" id="panel_directo_tab" data-bs-toggle="tab"
                            data-bs-target="#panel_directo" type="button" role="tab" aria-controls="panel_directo"
                            aria-selected="true">Directo</button>
                        <button class="nav-link" id="panel_inverso_tab" data-bs-toggle="tab"
                            data-bs-target="#panel_inverso" type="button" role="tab" aria-controls="panel_inverso"
                            aria-selected="false">Inverso</button>
                    </div>
                </nav>

            </div>
        </div>

        <div class="tab-content" id="nav-tabContent">
            <br>
            <div id="panel_directo" class="tab-pane fade show active card" id="panel_directo" role="tabpanel"
                aria-labelledby="panel_directo_tab" tabindex="0">
                <div class="card-header">
                    <h2>Problema geodésico Directo</h2>
                </div>
                <div class="card-body">
                    <!--aca inicia el formulario que envia los datos a js/calculo_geodesico.js-->
                    <form id="cal_directo">

                        <div class="form-group mt-3">
                            <label>Latitud: </label>
                            <div class="row">
                                <div class="col-md-3">
                                    <input type="number" class="form-control " placeholder="GG" id="lat_gg_d" min="0"
                                        max="360" required>
                                </div>
                                <div class="col-md-3">
                                    <input type="number" class="form-control" placeholder="MM" id="lat_mm_d" min="0"
                                        max="60" required>
                                </div>
                                <div class="col-md-3">
                                    <input type="number" class="form-control" placeholder="SS.SSSS" id="lat_ss_d"
                                        required min="0.00000" step="0.000001">
                                </div>
                                <div class="col-md-3">
                                    <select class="input-group-text " id="hemisferio">
                                        <option selected value="N">N</option>
                                        <option value="S">S</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-3">
                            <label>Longitud: </label>
                            <div class="row">
                                <div class="col-md-3">
                                    <input type="number" class="form-control" placeholder="GG" id="long_gg_d" min="0"
                                        max="360" required>
                                </div>
                                <div class="col-md-3">
                                    <input type="number" class="form-control" placeholder="MM" id="long_mm_d" min="0"
                                        max="60" required>
                                </div>
                                <div class="col-md-3">
                                    <input type="number" class="form-control" placeholder="SS.SSSS" id="long_ss_d"
                                        required step="0.00001">
                                </div>
                                <div class="col-md-3">
                                    <select class="input-group-text ">
                                        <option selected value="W">W</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group mt-3">
                                <div class="row">
                                    <label>Distancia (m): </label>
                                    <div class="col-md-6">
                                        <input type="number" class="form-control" placeholder="distancia en metros"
                                            id="dist_d" required step="0.000001">
                                    </div>
                                </div>

                            </div>
                        </div>
                        <div class="form-group mt-3">
                            <label>Azimut 1-2: </label>
                            <div class="row">
                                <div class="col-md-3">

                                    <input type="number" class="form-control" id="az_gg_d" placeholder="GG" min="0"
                                        max="360" required>
                                </div>
                                <div class="col-md-3">
                                    <input type="number" class="form-control" id="az_mm_d" placeholder="MM" min="0"
                                        max="60" required>
                                </div>
                                <div class="col-md-3">
                                    <input type="number" class="form-control" id="az_ss_d" placeholder="SS.SSSS"
                                        required step="0.000001">
                                </div>
                            </div>
                        </div>
                        <br>
                        <input type="submit" class="btn btn-info" value="Calcular">
                        <button class="btn btn-dark" id="btn_limpiar_d">Limpiar</button>


                    </form>
                    <br><br>
                    <!-- resultados del problema geodesico directo -->
                    <div id="res_directo">
                        <div class="card-header">
                            <h2>Resultados</h2>
                        </div>

                        <div class="form-group mt-3">
                            <label>Latitud 2: </label>
                            <div class="row">
                                <div class="col-md-3">
                                    <input id="res_lat_gg" type="number" class="form-control" placeholder="GG">
                                </div>
                                <div class="col-md-3">
                                    <input id="res_lat_mm" type="number" class="form-control" placeholder="MM">
                                </div>
                                <div class="col-md-3">
                                    <input id="res_lat_ss" type="number" class="form-control" placeholder="SS.SSSS">
                                </div>
                                <div class="col-md-3">
                                    <select class="input-group-text " id="res_hemisferio">
                                        <option selected value="N">N</option>
                                        <option value="S">S</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mt-3">
                            <label>Longitud 2: </label>
                            <div class="row">
                                <div class="col-md-3">
                                    <input id="res_long_gg" type="number" class="form-control" placeholder="GG">
                                </div>
                                <div class="col-md-3">
                                    <input id="res_long_mm" type="number" class="form-control" placeholder="MM">
                                </div>
                                <div class="col-md-3">
                                    <input id="res_long_ss" type="number" class="form-control" placeholder="SS.SSSS">
                                </div>
                                <div class="col-md-3">
                                    <select class="input-group-text ">
                                        <option selected value="W">W</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-3">
                            <label>Azimut 2-1: </label>
                            <div class="row">
                                <div class="col-md-3">
                                    <input id="res_az_gg" type="number" class="form-control" placeholder="GG">
                                </div>
                                <div class="col-md-3">
                                    <input id="res_az_mm" type="number" class="form-control" placeholder="MM">
                                </div>
                                <div class="col-md-3">
                                    <input id="res_az_ss" type="number" class="form-control" placeholder="SS.SSSS">
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>


            <!-- Panel inverso -->


            <div id="panel_inverso" class="tab-pane fade card" role="tabpanel" aria-labelledby="panel_inverso_tab"
                tabindex="0">
                <div class="card-header">
                    <h2>Problema geodésico Inverso</h2>
                </div>
                <div class="card-body">
                    <!--acá inicia el formulario del problema geodesico inverso-->
