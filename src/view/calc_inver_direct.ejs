                        <br>
                        <h5>Coordenadas del punto 2</h5>
                        <div class="form-group mt-3">
                            <label>Latitud 2: </label>
                            <div class="row">
                                <div class="col-md-3">
                                    <input id="lat2_gg_i" type="number" class="form-control" placeholder="GG" min="0"
                                        max="360" required>
                                </div>
                                <div class="col-md-3">
                                    <input id="lat2_mm_i" type="number" class="form-control" placeholder="MM" min="0"
                                        max="60" required>
                                </div>
                                <div class="col-md-3">
                                    <input id="lat2_ss_i" type="number" class="form-control" placeholder="SS.SSSS"
                                        step="0.000001" required>
                                </div>
                                <div class="col-md-3">
                                    <select class="input-group-text " id="hemisferio2_i">
                                        <option selected value="N">N</option>
                                        <option value="S">S</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-3">
                            <label>Longitud 2: </label>
                            <div class="row">
                                <div class="col-md-3">
                                    <input id="long2_gg_i" type="number" class="form-control" placeholder="GG" min="0"
                                        max="360" required>
                                </div>
                                <div class="col-md-3">
                                    <input id="long2_mm_i" type="number" class="form-control" placeholder="MM" min="0"
                                        max="60" required>
                                </div>
                                <div class="col-md-3">
                                    <input id="long2_ss_i" type="number" class="form-control" placeholder="SS.SSSS"
                                        step="0.000001" required>
                                </div>
                                <div class="col-md-3">
                                    <select class="input-group-text">
                                        <option selected value="W">W</option>
                                    </select>
                                </div>
                            </div>
                        </div>



                        <br>
                        <input type="submit" class="btn btn-info" value="Calcular">
                        <button class="btn btn-dark" id="btn_limpiar_i">Limpiar</button>
                        <br><br>
                    </form>
                    <div class="card-header">
                        <h2>Resultados</h2>
                    </div>
                    <div class="form-group mt-3">
                        <label>Distancia (m): </label>
                        <div class="row">
                            <div class="col-md-6">
                                <input id="res_s_i" type="number" class="form-control" placeholder="Distancia en metros">
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group mt-3">
                        <label>Azimut 1-2: </label>
                        <div class="row">
                            <div class="col-md-3">
                                <input id="res_az12_gg_i" type="number" class="form-control" placeholder="GG">
                            </div>
                            <div class="col-md-3">
                                <input id="res_az12_mm_i" type="number" class="form-control" placeholder="MM">
                            </div>
                            <div class="col-md-3">
                                <input id="res_az12_ss_i" type="number" class="form-control" placeholder="SS.SSSS">
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group mt-3">
                        <label>Azimut 2-1: </label>
                        <div class="row">
                            <div class="col-md-3">
                                <input id="res_az21_gg_i" type="number" class="form-control" placeholder="GG">
                            </div>
                            <div class="col-md-3">
                                <input id="res_az21_mm_i" type="number" class="form-control" placeholder="MM">
                            </div>
                            <div class="col-md-3">
                                <input id="res_az21_ss_i" type="number" class="form-control" placeholder="SS.SSSS">
