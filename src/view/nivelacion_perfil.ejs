<%- include('./partials/cabecero.ejs', {"titulo": "ITRF"}); %>
<%- include('./partials/menu.ejs'); %>

    <div class="panel">
      <div class="panel">
          <h4>Cálculo Ondulación Punto Individual</h4>
      </div>
    <br>
    <div class="row g-4">
      <!-- Panel de Carga de Archivo -->
      <div class="col-lg-4">
        <div class="panel">
          <h5>Cargar Archivo CSV</h5>
          <p class="text-muted">Sube un archivo en formato CSV con las columnas <strong>ID, Altura Elipsoidal y Altura Geoidal</strong>.</p>
          <input type="file" class="form-control mb-3" id="file-upload" accept=".csv">
          <button type="button" class="btn btn-primary w-100" id="process-csv">Procesar Archivo</button>
          <br>
          <br>
          <button type="button" class="btn btn-success w-100" id="calculate-leveling">Calcular Nivelación</button>
          <button type="button" class="btn btn-secondary w-100 mt-2" id="clear-btn">Limpiar</button>
        </div>
      </div>

      <!-- Vista previa de datos -->
      <div class="col-lg-4">
        <div class="panel">
          <h5>Vista Previa del Archivo</h5>
          <div class="file-preview-container">
            <table class="table table-dark table-striped file-preview" id="file-preview-table" style="display: none;">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Latitud</th>
                  <th>Longitud</th>
                  <th>Altura Elipsoidal</th>
                  <th>Altura Geoidal</th>
                </tr>
              </thead>
              <tbody id="file-preview-body"></tbody>
            </table>
            <p class="text-muted" id="empty-preview" style="display: block;">No se ha cargado ningún archivo aún.</p>
          </div>
        </div>
      </div>

      <!-- Panel del Mapa -->
      <div class="col-lg-4">
        <div class="panel">
          <h5>Mapa de Puntos Base</h5>
          <div id="map"></div>
          <p class="text-muted mt-3">
            Interactúa con el mapa para ubicar puntos base. Los puntos base se utilizan para calcular alturas niveladas.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mathjs/11.5.0/math.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
  <script src="controller/NIV_GNSS_PER.js"></script>

 

