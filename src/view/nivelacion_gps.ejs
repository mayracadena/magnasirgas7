<%- include('./partials/cabecero.ejs', {"titulo": "Calculo Nivelación GPS Punto Individual"}); %>
<%- include('./partials/menu.ejs'); %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calculo Nivelación GPS Punto Individual</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    :root {
      --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
      --primary-color: #ffffff;
      --secondary-color: #001f3f;
      --text-color: #ffffff;
    }

    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--main-bg-color);
      color: var(--text-color);
      overflow: hidden;
    }

    #particles-js {
      position: absolute;
      width: 100%;
      height: 100%;
      z-index: -1;
    }

    /* Se mantiene la definición original */
    .main-content {
      margin-left: 300px;
      padding: 20px;
    }

    .title {
      text-align: center;
      color: var(--primary-color);
      margin-bottom: 20px;
    }

    .content-container {
      display: flex;
      gap: 20px;
    }

    .panel {
      background: rgba(255, 255, 255, 0.05);
      padding: 20px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      flex: 1;
    }

    .form-control {
      background: rgba(253, 251, 251, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: var(--text-color);
    }

    .form-control:focus {
      background: rgba(251, 248, 248, 0.15);
      color: var(--text-color);
    }

    .form-control::placeholder {
      color: #ffffff;
      opacity: 1;
    }

    .form-control:focus::placeholder {
      color: #ffffff;
    }

    :-ms-input-placeholder {
      color: #ffffff;
    }

    ::-ms-input-placeholder {
      color: #ffffff;
    }

    .btn {
      border: none;
      transition: all 0.3s ease;
    }

    .btn-primary:hover {
      background-color: var(--secondary-color);
    }

    .right-section {
      display: flex;
      flex-direction: column;
      flex: 2;
    }

    #map {
      height: 400px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      margin-bottom: 10px;
      border-radius: 15px;
      overflow: hidden;
    }

    .puntos-base-container {
      max-height: 200px;
      overflow-y: auto;
      background: rgba(255, 255, 255, 0.05);
      padding: 10px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* =========== Override para que no se desplace demasiado a la derecha =========== */
    @media (min-width: 0px) {
      .main-content {
        margin-left: 0 !important;  /* Anula la línea original */
        margin: 0 auto !important;  /* Centra horizontalmente */
        max-width: 4000px;          /* Ajusta si quieres un ancho diferente */
      }
    }
  </style>
</head>
<body>
  <!-- Fondo de partículas -->
  <div id="particles-js"></div>

  <div class="main-content">
    <h4>Calculo Nivelación GNSS Punto Individual</h4>
    <div class="content-container">
      <!-- Panel de Coordenadas (izquierda) -->
      <div class="panel">
        <h6>Tipo de Coordenada</h6>
        <ul class="nav nav-tabs" id="myTab" role="tablist">
          <li class="nav-item">
            <button class="nav-link active" id="elipsoidal-tab" data-bs-toggle="tab" data-bs-target="#elipsoidal" type="button" role="tab" aria-controls="elipsoidal" aria-selected="true">Elipsoidal Sexagesimal</button>
          </li>
          <li class="nav-item">
            <button class="nav-link" id="elipsoidaldecimal-tab" data-bs-toggle="tab" data-bs-target="#coordenadas-decimales" type="button" role="tab" aria-controls="elipsoidaldecimal" aria-selected="false">Elipsoidal Decimal</button>
          </li>
        </ul>
        <div class="tab-content" id="myTabContent">
          <div class="tab-pane fade show active" id="elipsoidal" role="tabpanel">
            <!-- Coordenadas Sexagesimales -->
            <div class="form-group mt-3">
              <label for="latitud">Latitud (Sexagesimal):</label>
              <div class="row">
                <div class="col-md-3"><input type="text" class="form-control" placeholder="GG" id="latitud-grados"></div>
                <div class="col-md-3"><input type="text" class="form-control" placeholder="MM" id="latitud-minutos"></div>
                <div class="col-md-3"><input type="text" class="form-control" placeholder="SS.DDDDD" id="latitud-segundos"></div>
                <div class="col-md-3">
                  <select class="form-control" id="latitud-hemisferio">
                    <option value="N">N</option>
                    <option value="S">S</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="form-group mt-3">
              <label for="longitud">Longitud (Sexagesimal):</label>
              <div class="row">
                <div class="col-md-3"><input type="text" class="form-control" placeholder="GG" id="longitud-grados"></div>
                <div class="col-md-3"><input type="text" class="form-control" placeholder="MM" id="longitud-minutos"></div>
                <div class="col-md-3"><input type="text" class="form-control" placeholder="SS.DDDDD" id="longitud-segundos"></div>
                <div class="col-md-3">
                  <select class="form-control" id="longitud-hemisferio">
                    <option value="E">E</option>
                    <option value="W">W</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
          <!-- Coordenadas Decimales -->
          <div class="tab-pane fade" id="coordenadas-decimales" role="tabpanel">
            <div class="form-group mt-3">
              <label for="latitud-decimal">Latitud (Decimal):</label>
              <input type="text" class="form-control" placeholder="Latitud (Decimal)" id="latitud-decimal">
            </div>
            <div class="form-group mt-3">
              <label for="longitud-decimal">Longitud (Decimal):</label>
              <input type="text" class="form-control" placeholder="Longitud (Decimal)" id="longitud-decimal">
            </div>
          </div>
        </div>
        <div class="form-group mt-3">
          <label for="altura-elipsoidal">Altura Elipsoidal (h):</label>
          <input type="number" class="form-control" id="altura-elipsoidal" placeholder="Ingrese altura elipsoidal">
        </div>
        <div class="form-group mt-3">
          <label for="altura-geoidal">Ondulación Geoidal (N):</label>
          <input type="number" class="form-control" id="ondulacion" placeholder="Ingrese altura geoidal">
        </div>        
        <div class="text-center mt-3">
          <button type="button" class="btn btn-primary" id="procesar">Procesar</button>
          <button type="button" class="btn btn-secondary" id="clearBtn">Limpiar</button>
        </div>
      
        <div class="mb-3">
          <label for="coordX" class="form-label">Altura Nivelada</label>
          <input type="number" class="form-control" id="Altura_Nivelada" required>
          <button type="button" class="btn btn-success mt-3" id="calculate-leveling">Calcular Nivelación</button>
        </div>
      </div>

      <!-- Sección derecha: Mapa y Puntos Base -->
      <div class="right-section">
        <div id="map"></div>
        <div class="panel puntos-base-container">
          <h4>Puntos base</h4>
          <ul id="points-list"></ul>
          <p id="validation-message" style="color: red; display: none;">
            Por favor, selecciona al menos 6 puntos.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mathjs/11.5.0/math.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
  <script src="controller/Nivelacion_gps.js"></script>
  <script>
    // Partículas de fondo
    particlesJS('particles-js', {
      particles: {
        number: { value: 150 },
        color: { value: '#00d4ff' },
        shape: { type: 'circle' },
        opacity: { value: 0.5 },
        size: { value: 3 },
        line_linked: {
          enable: true,
          distance: 200,
          color: '#00d4ff',
          opacity: 0.4,
          width: 1
        },
        move: {
          enable: true,
          speed: 2
        }
      },
      interactivity: {
        events: {
          onhover: { enable: true, mode: 'grab' },
          onclick: { enable: true, mode: 'push' }
        },
        modes: {
          grab: { distance: 200, line_linked: { opacity: 1 } }
        }
      },
      retina_detect: true
    });
  </script>
</body>
</html>
