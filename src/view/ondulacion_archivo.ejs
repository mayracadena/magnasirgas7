<%- include('./partials/cabecero.ejs', {"titulo": "ITRF"}); %>
<%- include('./partials/menu.ejs'); %>

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cálculo Ondulación Geoidal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <style>
      :root {
        --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
        --primary-color: #ffffff;
        --secondary-color: #001f3f;
        --text-color: #ffffff;
      }

      body {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: var(--main-bg-color);
        color: var(--text-color);
        overflow: hidden;
      }

      #particles-js {
        position: absolute;
        width: 100%;
        height: 100%;
        z-index: -1;
      }

      .main-content {
        margin-left: 300px;
        padding: 20px;
      }

      .title {
        text-align: center;
        color: var(--primary-color);
        margin-bottom: 20px;
      }

      .content-container {
        display: flex;
        gap: 20px;
      }

      .panel {
        background: rgba(255, 255, 255, 0.05);
        padding: 20px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        flex: 1;
      }

      .form-control {
        background: rgba(253, 251, 251, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--text-color);
      }

      .form-control:focus {
        background: rgba(251, 248, 248, 0.15);
        color: var(--text-color);
      }
      .form-control::placeholder {
        color: #ffffff;
        opacity: 1;
      }

      .form-control:focus::placeholder {
        color: #ffffff;
      }

      .btn {
        border: none;
        transition: all 0.3s ease;
      }

      .btn-primary:hover {
        background-color: var(--secondary-color);
      }

      .right-panel {
        flex: 2;
      }

      #map {
        height: 400px;
        border: 2px solid rgba(255, 255, 255, 0.2);
        margin-bottom: 10px;
        border-radius: 15px;
        overflow: hidden;
      }

      .puntos-base-container {
        max-height: 200px;
        overflow-y: auto;
        background: rgba(255, 255, 255, 0.05);
        padding: 10px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      table.file-preview {
          width: 100%;
          table-layout: auto;
          border-collapse: collapse;
          font-size: 14px;
      }

      table.file-preview th,
      table.file-preview td {
        text-align: center;
        padding: 8px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        word-wrap: break-word;
      }

      table.file-preview th {
        background-color: #f8f9fa;
        color: #000000;
      }

      table.file-preview td {
        color: #ffffff;
      }

      table.file-preview tbody tr:nth-of-type(odd) {
        background-color: rgba(255, 255, 255, 0.05);
      }

      table.file-preview tbody tr:nth-of-type(even) {
        background-color: rgba(0, 0, 0, 0.1);
      }
  </style>
</head>
<body>
    <div id="particles-js"></div>
    <div class="main-content">
      <h1 class="title">Cálculo de Ondulación Geoidal</h1>
      <div class="content-container">
        <!-- Sección izquierda: Configuración y Carga -->
        <div class="panel left-panel">
          <h4>Configuración y Carga</h4>
          <form id="ondulacionForm">
            <div class="mb-3">
              <label for="tipo-coordenada" class="form-label">Seleccione el tipo de coordenada:</label>
              <select class="form-control" id="tipo-coordenada">
                <option value="">-- Seleccione un tipo --</option>
                <option value="elipsoidal">Elipsoidal (decimal)</option>
                <option value="elipsoidales-grados">Elipsoidales en grados</option>
                <option value="utm">UTM (Este, Norte, Zona)</option>
                <option value="geocentrica">Geocéntrica (X, Y, Z)</option>
                <option value="plana-cartesiana">Plana Cartesiana (X, Y)</option>
                <option value="gauss-kruger">Gauss Krüger (Este, Norte, Zona)</option>
                <option value="origen-nacional">Origen Nacional (Este, Norte)</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="cargar-archivo" class="form-label">Seleccione un archivo CSV:</label>
              <input type="file" class="form-control" id="cargar-archivo" accept=".csv">
            </div>
            <div class="text-center mt-3">
              <button type="button" id="calcular" class="btn btn-primary me-2"><i class="bi bi-calculator"></i> Calcular</button>
              <button type="button" id="limpiar" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Limpiar</button>
            </div>
          </form>
        </div>

        <!-- Sección derecha: Tabla -->
        <div class="panel right-panel">
          <h4>Datos Cargados</h4>
          <div class="table-responsive" style="max-height: 400px; overflow:auto;">
            <table class="file-preview" id="tabla-datos">
              <thead>
                <!-- Cabeceras dinámicas se generan con JS -->
              </thead>
              <tbody>
                <!-- Datos cargados dinámicamente con JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    
    <script src="controller/ondulacion_masivo.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      // Configuración de partículas
      particlesJS('particles-js', {
        particles: {
          number: { value: 150 },
          color: { value: '#00d4ff' },
          shape: { type: 'circle' },
          opacity: { value: 0.5 },
          size: { value: 3 },
          line_linked: {
            enable: true,
            distance: 200,
            color: '#00d4ff',
            opacity: 0.4,
            width: 1
          },
          move: {
            enable: true,
            speed: 2
          }
        },
        interactivity: {
          events: {
            onhover: { enable: true, mode: 'grab' },
            onclick: { enable: true, mode: 'push' }
          },
          modes: {
            grab: { distance: 200, line_linked: { opacity: 1 } }
          }
        },
        retina_detect: true
      });
    </script>
</body>
</html>




