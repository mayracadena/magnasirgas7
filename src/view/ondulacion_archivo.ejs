<%- include('./partials/menu.ejs'); %>

   
    
      <!-- Contenedor principal -->
      <div class="content-container">
        <h1 class="title">Cálculo de Ondulación Geoidal</h1>
        <!-- Sección izquierda: módulos -->
        <div class="panel left-panel">
          <h4>Configuración y Carga</h4>
          <form id="ondulacionForm">
            <div class="mb-3">
              <label for="tipo-coordenada" class="form-label">Seleccione el tipo de coordenada:</label>
              <select class="form-control" id="tipo-coordenada">
                <option value="">-- Seleccione un tipo --</option>
                <option value="elipsoidal">Elipsoidal (decimal)</option>
                <option value="elipsoidales-grados">Elipsoidales en grados</option>
                <option value="utm">UTM (Este, Norte, Zona)</option>
                <option value="geocentrica">Geocéntrica (X, Y, Z)</option>
                <option value="plana-cartesiana">Plana Cartesiana (X, Y)</option>
                <option value="gauss-kruger">Gauss Krüger (Este, Norte, Zona)</option>
                <option value="origen-nacional">Origen Nacional (Este, Norte)</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="cargar-archivo" class="form-label">Seleccione un archivo CSV:</label>
              <input type="file" class="form-control" id="cargar-archivo" accept=".csv">
            </div>
            <div class="text-center mt-3">
              <button type="button" id="calcular" class="btn btn-primary me-2"><i class="bi bi-calculator"></i> Calcular</button>
              <button type="button" id="limpiar" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Limpiar</button>
            </div>
          </form>
        </div>
    
        <!-- Sección derecha: tabla -->
        <div class="panel right-panel">
          <h4>Datos Cargados</h4>
          <div class="table-responsive" style="max-height: 400px; overflow:auto;">
            <table class="file-preview" id="tabla-datos">
              <thead>
                <!-- Cabeceras dinámicas -->
              </thead>
              <tbody>
                <!-- Datos cargados dinámicamente -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    

  <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
 
  <script>
    // Configuración de partículas
 
    function generarCabeceras(tipo) {
      const thead = document.querySelector('#tabla-datos thead');
      thead.innerHTML = '';

      let headers = [];
      switch (tipo) {
        case 'elipsoidal':
          headers = ['ID', 'Latitud', 'Longitud'];
          break;
        case 'elipsoidales-grados':
          headers = ['ID', 'Latitud', 'Longitud'];
          break;
        case 'utm':
          headers = ['ID', 'Este', 'Norte', 'Zona'];
          break;
        case 'geocentrica':
          headers = ['ID', 'X', 'Y', 'Z'];
          break;
        case 'plana-cartesiana':
          headers = ['ID', 'X', 'Y'];
          break;
        case 'gauss-kruger':
          headers = ['ID', 'Este', 'Norte', 'Zona'];
          break;
        case 'origen-nacional':
          headers = ['ID', 'Este', 'Norte'];
          break;
        default:
          headers = ['ID'];
          break;
      }

      const tr = document.createElement('tr');
      headers.forEach(h => {
        const th = document.createElement('th');
        th.textContent = h;
        tr.appendChild(th);
      });
      thead.appendChild(tr);
    }

    document.getElementById('tipo-coordenada').addEventListener('change', function () {
      const tipo = this.value;
      if (tipo) {
        generarCabeceras(tipo);
      }
    });

    document.getElementById('cargar-archivo').addEventListener('change', function (event) {
      const tipoCoordenada = document.getElementById('tipo-coordenada').value;

      if (!tipoCoordenada) {
        alert('Por favor seleccione un tipo de coordenada antes de cargar el archivo.');
        this.value = '';
        return;
      }

      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function (e) {
          const lines = e.target.result.split('\n').map(line => line.trim()).filter(line => line !== '');
          const tableBody = document.querySelector('#tabla-datos tbody');
          tableBody.innerHTML = ''; // Limpiar tabla antes de cargar nuevos datos

          const dataLines = lines.slice(1); // Ignorar la primera línea (encabezado del archivo)
          const columnsCount = document.querySelectorAll('#tabla-datos thead th').length;

          dataLines.forEach((line, index) => {
            const columns = line.split(',').map(col => col.trim());
            if (columns.length === columnsCount) {
              const tr = document.createElement('tr');
              columns.forEach(col => {
                const td = document.createElement('td');
                td.textContent = col;
                tr.appendChild(td);
              });
              tableBody.appendChild(tr);
            }
          });
        };
        reader.readAsText(file);
      }
    });
  // Función para procesar el archivo cargado y calcular las ondulaciones
  function procesarArchivo(datos) {
      const resultados = [];

      datos.forEach(row => {
          const id = row[0];
          const latitud = parseFloat(row[1]);
          const longitud = parseFloat(row[2]);

          calcularOndulacionGeoidal(latitud, longitud)
              .then(ondulacion => {
                  resultados.push({ id, latitud, longitud, ondulacion: ondulacion.toFixed(3) });

                  if (resultados.length === datos.length) {
                      generarArchivoCSV(resultados);
                  }
              })
              .catch(err => console.error(`Error al calcular ondulación para ID ${id}:`, err));
      });
  }
    document.getElementById('limpiar').addEventListener('click', function () {
      document.querySelector('#tabla-datos thead').innerHTML = '';
      document.querySelector('#tabla-datos tbody').innerHTML = '';
      document.getElementById('cargar-archivo').value = '';
      document.getElementById('tipo-coordenada').value = '';
    });

  

  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


