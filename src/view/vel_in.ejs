                      <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="GG" id="latitud-grados-partida">
                      </div>
                      <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="MM" id="latitud-minutos-partida">
                      </div>
                      <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="SS.DDDDD" id="latitud-segundos-partida">
                      </div>
                      <div class="col-md-3">
                        <select class="form-control" id="latitud-hemisferio-partida">
                          <option value="N">N</option>
                          <option value="S">S</option>
                        </select>
                      </div>
                    </div>
                  </div>
                  <div class="form-group mt-3">
                    <label for="longitud-partida">Longitud:</label>
                    <div class="row">
                      <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="GG" id="longitud-grados-partida">
                      </div>
                      <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="MM" id="longitud-minutos-partida">
                      </div>
                      <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="SS.DDDDD" id="longitud-segundos-partida">
                      </div>
                      <div class="col-md-3">
                        <select class="form-control" id="longitud-hemisferio-partida">
                          <option value="E">E</option>
                          <option value="W">W</option>
                        </select>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- Resto de las pestañas tal cual -->
                <!-- ... (No se muestra para abreviar) ... -->
              </div>
            </div>
          </div>
        </div>
    
        <!-- Columna para Tipo de Coordenada de Destino -->
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              Tipo de Coordenada de Destino
            </div>
            <div class="card-body">
              <!-- Navegación de pestañas -->
              <ul class="nav nav-tabs" id="myTabDestino" role="tablist">
                <li class="nav-item" role="presentation">
                  <button class="nav-link active" id="elipsoidal-tab-destino" data-bs-toggle="tab" data-bs-target="#elipsoidal-destino" type="button" role="tab" aria-controls="elipsoidal-destino" aria-selected="true">Elipsoidal Sexagesimal</button>
                </li>
                <!-- Resto de las pestañas tal cual -->
                <!-- ... (No se muestra para abreviar) ... -->
              </ul>
              <!-- Contenido de las pestañas -->
