            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Resto del contenido del panel individual -->
    <!-- Aquí mantienes el contenido original del panel individual tal cual -->
    <!-- Fila para Tipo de Coordenada de Partida y Destino -->
    <p></p>    
    <div class="container-fluid">
      <!-- Fila para Tipo de Coordenada de Partida y Destino -->
      <div class="row mt-3">
        <!-- Columna para Tipo de Coordenada de Partida -->
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              Tipo de Coordenada de Partida
            </div>
            <div class="card-body">
              <!-- Navegación de pestañas -->
              <ul class="nav nav-tabs" id="myTabPartida" role="tablist">
                <li class="nav-item" role="presentation">
