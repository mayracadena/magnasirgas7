<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interfaz de cambio de epoca</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Variables de raíz */
    :root {
      --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
      --primary-color: #00d4ff;
      --secondary-color: #001f3f;
      --secondary-hover-color: #0056b3;
      --text-color: #ffffff;
      --text-muted-color: rgba(255, 255, 255, 0.5);
      --bg-translucent: rgba(255, 255, 255, 0.05);
      --border-color-light: rgba(255, 255, 255, 0.1);
      --border-color-regular: rgba(255, 255, 255, 0.2);
      --focus-bg-color: rgba(255, 255, 255, 0.2);
      --form-control-bg-color: rgba(255, 255, 255, 0.1);
      --card-header-bg-color: rgba(0, 31, 63, 0.8);
      --btn-secondary-bg-color: #555555;
      --btn-secondary-hover-bg-color: #777777;
      --panel-bg-color: rgba(255, 255, 255, 0.05);
      --panel-border-color: rgba(255, 255, 255, 0.1);
      --btn-secondary-text-color: #faffff;
    }
  
    /* Estilos globales */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--main-bg-color);
      color: var(--text-color);
      overflow: hidden;
      height: 100vh;
    }
  
    /* Fondo de partículas */
    #particles-js {
      position: absolute;
      width: 100%;
      height: 100%;
      z-index: -1;
    }
  .main-container {
    display: flex;
  
    width: 100vw; /* Ancho completo de la ventana */
    overflow: hidden; /* Evita que el contenedor principal tenga desplazamiento */
  }
  
  /* Barra lateral */
  .sidebar {
    width: 250px; /* Ajusta el ancho según tu diseño */
    background-color: #0056b3; /* Color de fondo de la barra lateral */
    overflow-y: auto; /* Agrega desplazamiento en la barra lateral si es necesario */
  }
  /* Contenido principal */
  .main-content {
    flex: 1; /* Ocupa el espacio restante a la derecha de la barra lateral */
    display: flex;
    margin-left: 300px;
    flex-direction: column;
    max-height: 100vh; /* Limita la altura del contenido principal a la ventana */
    overflow-y: auto; /* Permite el desplazamiento vertical si el contenido es mayor */
    padding: 20px;
    background: var(--bg-translucent);
  }
  
  
    /* Estilos de tarjeta */
    .card { 
      background: transparent;
      border: none;
    }
  
    .card-header {
      position: sticky;
      top: 0;
      width: 100%;
      background: var(--card-header-bg-color);
      color: var(--primary-color);
      text-align: center;
      z-index: 10;
      padding: 15px;
      border-bottom: 1px solid var(--border-color-regular);
    }
  
    .card-body {
      padding: 30px;
    }
  
    /* Estilos de formulario */
    .form-group label {
      font-weight: bold;
      color: var(--primary-color);
    }
  
    .form-control {
      background: var(--form-control-bg-color);
      border: 1px solid var(--border-color-regular);
      color: var(--text-color);
    }
  
    .form-control::placeholder {
      color: var(--text-muted-color);
    }
  
    .form-control:focus {
      background: var(--focus-bg-color);
      color: var(--text-color);
    }
  
    /* Botones */
    .btn {
      border: none;
      transition: background-color 0.3s, transform 0.3s;
    }
  
    .btn:hover {
      transform: translateY(-2px);
    }
  
    .btn-primary {
      background-color: var(--secondary-color);
      color: var(--primary-color);
    }
  
    .btn-primary:hover {
      background-color: var(--secondary-hover-color);
    }
  
    .btn-secondary {
      background-color: var(--btn-secondary-bg-color);
      color: var(--btn-secondary-text-color);
    }
  
    .btn-secondary:hover {
      background-color: var(--btn-secondary-hover-bg-color);
    }
  
    /* Paneles */
    .panel {
      background: var(--panel-bg-color);
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 10px;
      border: 1px solid var(--panel-border-color);
    }
  
    .panel h2,
    .panel h3 {
      margin-bottom: 20px;
      color: var(--primary-color);
    }
  
    /* Pestañas */
    .nav-tabs .nav-link {
      background: transparent;
      border: none;
      color: var(--primary-color);
      font-weight: bold;
      transition: color 0.3s, border-bottom 0.3s;
    }
  
    .nav-tabs .nav-link.active {
      color: #000000;
      border-bottom: 2px solid var(--primary-color);
    }
  
    .nav-tabs .nav-link:hover {
      color: var(--text-color);
    }
  
    /* Personalización de partículas */
    .particles-js-canvas-el {
      position: absolute;
      top: 0;
      left: 0;
    }
  
    /* Consultas de medios */
    @media (max-width: 768px) {
      .row {
        flex-direction: column;
      }
      .row .col {
        margin-bottom: 15px;
      }
    }
  </style>
  
</head>
<body>
   <!-- Particles Background -->
   <div id="particles-js"></div>

    <div class="main-content" >
    <div class="card shadow">
    <div class="card shadow">
        <div class="card-header">
            <h2>Cambio de Época</h2>
        </div>
        <div class="card-body">

