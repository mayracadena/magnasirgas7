<%- include('./partials/cabecero.ejs', {"titulo": "ITRF" }); %>
<%- include('./partials/menu.ejs'); %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interfaz de Cálculo Geodésico</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      padding: 20px;
    }
    .nav-tabs .nav-link {
      background-color: #e9ecef;
      color: #495057;
    }
    .nav-tabs .nav-link.active {
      background-color: #fff;
      color: #000;
    }
    .form-control {
      margin-bottom: 10px;
    }
    .tab-pane {
      margin-top: 15px;
    }
  </style>
</head>
<body>

<div class="container">

  <!-- Primera Fila: Sistema de Referencia y Tipo de Coordenada de Partida -->
  <div class="row">
    <!-- Sistema de Referencia de Partida -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          Sistema de Referencia de Partida
        </div>
        <div class="card-body">
          <div class="form-group">
            <!-- Opciones de Sistema de Referencia de Partida -->
            <div class="form-check">
              <input class="form-check-input" type="radio" name="sistemaPartida" id="magnaSIRGASPartida" checked>
              <label class="form-check-label" for="magnaSIRGASPartida">MAGNA-SIRGAS</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="sistemaPartida" id="datumBogotaPartida">
              <label class="form-check-label" for="datumBogotaPartida">Datum Bogotá</label>
            </div>
          </div>
          <div class="form-group">
            <label for="fechaRastreoPartida">Fecha de Rastreo:</label>
            <input type="date" class="form-control" id="fechaRastreoPartida">
          </div>
          <div class="form-group">
            <label for="modeloVelocidadesPartida">Modelo Velocidades:</label>
            <select class="form-control" id="modeloVelocidadesPartida">
              <option>VEMOS 2017</option>
              <option>VEMOS 2015</option>
              <option>VEMOS 2009</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Tipo de Coordenada de Partida -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          Tipo de Coordenada de Partida
        </div>
        <div class="card-body">
          <ul class="nav nav-tabs" id="tipoCoordenadaPartidaTabs" role="tablist">
            <li class="nav-item">
              <a class="nav-link active" id="elipsoidal-partida-tab" data-bs-toggle="tab" href="#elipsoidal-partida" role="tab">Elipsoidal</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="utm-partida-tab" data-bs-toggle="tab" href="#utm-partida" role="tab">UTM</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="gauss-partida-tab" data-bs-toggle="tab" href="#gauss-partida" role="tab">Gauss Krüger</a>
            </li>
          </ul>
          <div class="tab-content" id="tipoCoordenadaPartidaContent">
            <div class="tab-pane fade show active" id="elipsoidal-partida" role="tabpanel">
              <div class="form-group">
                <label>Latitud:</label>
                <input type="text" class="form-control" placeholder="GG">
                <input type="text" class="form-control" placeholder="MM">
                <input type="text" class="form-control" placeholder="SS.DDDDD">
                <select class="form-control">
                  <option>N</option>
                  <option>S</option>
                </select>
              </div>
              <div class="form-group">
                <label>Longitud:</label>
                <input type="text" class="form-control" placeholder="GG">
                <input type="text" class="form-control" placeholder="MM">
                <input type="text" class="form-control" placeholder="SS.DDDDD">
                <select class="form-control">
                  <option>E</option>
                  <option>W</option>
                </select>
              </div>
            </div>
            <!-- Otras pestañas de coordenadas aquí -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Segunda Fila: Sistema de Referencia y Tipo de Coordenada de Llegada -->
  <div class="row mt-3">
    <!-- Sistema de Referencia de Llegada -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          Sistema de Referencia de Llegada
        </div>
        <div class="card-body">
          <div class="form-group">
            <!-- Opciones de Sistema de Referencia de Llegada -->
            <div class="form-check">
              <input class="form-check-input" type="radio" name="sistemaLlegada" id="magnaSIRGASLlegada" checked>
              <label class="form-check-label" for="magnaSIRGASLlegada">MAGNA-SIRGAS</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="sistemaLlegada" id="datumBogotaLlegada">
              <label class="form-check-label" for="datumBogotaLlegada">Datum Bogotá</label>
            </div>
          </div>
          <div class="form-group">
            <label for="fechaReferenciaLlegada">Fecha de Referencia:</label>
            <input type="date" class="form-control" id="fechaReferenciaLlegada">
          </div>
          <div class="form-group">
            <label for="modeloVelocidadesLlegada">Modelo Velocidades:</label>
            <select class="form-control" id="modeloVelocidadesLlegada">
              <option>VEMOS 2017</option>
              <option>VEMOS 2015</option>
              <option>VEMOS 2009</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Tipo de Coordenada de Llegada -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          Tipo de Coordenada de Llegada
        </div>
        <div class="card-body">
          <ul class="nav nav-tabs" id="tipoCoordenadaLlegadaTabs" role="tablist">
            <li class="nav-item">
              <a class="nav-link active" id="elipsoidal-llegada-tab" data-bs-toggle="tab" href="#elipsoidal-llegada" role="tab">Elipsoidal</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="utm-llegada-tab" data-bs-toggle="tab" href="#utm-llegada" role="tab">UTM</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="gauss-llegada-tab" data-bs-toggle="tab" href="#gauss-llegada" role="tab">Gauss Krüger</a>
            </li>
          </ul>
          <div class="tab-content" id="tipoCoordenadaLlegadaContent">
            <div class="tab-pane fade show active" id="elipsoidal-llegada" role="tabpanel">
              <div class="form-group">
                <label>Latitud:</label>
                <input type="text" class="form-control" placeholder="GG">
                <input type="text" class="form-control" placeholder="MM">
                <input type="text" class="form-control" placeholder="SS.DDDDD">
                <select class="form-control">
                  <option>N</option>
                  <option>S</option>
                </select>
              </div>
              <div class="form-group">
                <label>Longitud:</label>
                <input type="text" class="form-control" placeholder="GG">
                <input type="text" class="form-control" placeholder="MM">
                <input type="text" class="form-control" placeholder="SS.DDDDD">
                <select class="form-control">
                  <option>E</option>
                  <option>W</option>
                </select>
              </div>
            </div>
            <!-- Otras pestañas de coordenadas aquí -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tercera Fila: Sistema de Referencia de Destino -->
  <div class="row mt-3">
    <!-- Sistema de Referencia de Destino -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          Sistema de Referencia de Destino
        </div>
        <div class="card-body">
          <div class="form-group">
            <!-- Opciones de Sistema de Referencia de Destino -->
            <div class="form-check">
              <input class="form-check-input" type="radio" name="sistemaDestino" id="magnaSIRGASDestino" checked>
              <label class="form-check-label" for="magnaSIRGASDestino">MAGNA-SIRGAS</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="sistemaDestino" id="datumBogotaDestino">
              <label class="form-check-label" for="datumBogotaDestino">Datum Bogotá</label>
            </div>
          </div>
          <div class="form-group">
            <label for="fechaReferenciaDestino">Fecha de Referencia:</label>
            <input type="date" class="form-control" id="fechaReferenciaDestino">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Botones de Acción -->
  <div class="row mt-3">
    <div class="col-md-12 text-center">
      <button class="btn btn-primary">Calcular</button>
      <button class="btn btn-secondary">Limpiar</button>
    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

<%- include('./partials/pie.ejs'); %>
