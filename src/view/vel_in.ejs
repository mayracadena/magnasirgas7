<%- include('./partials/cabecero.ejs', {"titulo": "Cambio de época" }); %>
<%- include('./partials/menu.ejs'); %>

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cambio de Época</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
      --primary-color: #00d4ff;
      --secondary-color: #001f3f;
      --text-color: #ffffff;
    }
  
    body {
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--main-bg-color);
      color: var(--text-color);
      overflow: hidden;
    }
  
    #particles-js {
      position: absolute;
      width: 100%;
      height: 100%;
      z-index: -1;
    }
  
    .main-content {
      margin-left: 300px;
      padding: 20px;
    }
  
    .title {
      text-align: center;
      color: var(--primary-color);
      margin-bottom: 20px;
    }
  
    /* Contenedor principal con Flexbox */
    .content-container {
      display: flex;
      gap: 20px;
    }
  
    /* Panel de coordenadas (izquierda) */
    .panel {
      background: rgba(255, 255, 255, 0.05);
      padding: 20px;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      flex: 1;
    }
  
    .form-control {
      background: rgba(253, 251, 251, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: var(--text-color);
    }
  
    .form-control:focus {
      background: rgba(251, 248, 248, 0.15);
      color: var(--text-color);
    }
    .form-control::placeholder {
    color: #ffffff; /* Cambia el color del placeholder a blanco */
    opacity: 1;
  }
  
  .form-control:focus::placeholder {
    color: #ffffff; /* Mantiene el color blanco al enfocarse */
  }
  
  /* Compatibilidad adicional */
  :-ms-input-placeholder {
    color: #ffffff;
  }
  
  ::-ms-input-placeholder {
    color: #ffffff;
  }
    .btn {
      border: none;
      transition: all 0.3s ease;
    }
  
    .btn-primary:hover {
      background-color: var(--secondary-color);
    }
  
    /* Sección derecha con el mapa y puntos base */
    .right-section {
      display: flex;
      flex-direction: column;
      flex: 2;
    }
  </style>
  
</head>
<body>
  <div id="particles-js"></div>

  <div class="main-content">
      <div class="panel">
          <div class="card-header">
              <h2>Cambio de Época</h2>
          </div>
          <div class="card-body">
              <nav>
                  <div class="nav nav-tabs" id="nav-tab" role="tablist">
                      <button class="nav-link active" id="panel_directo_tab" data-bs-toggle="tab" data-bs-target="#panel_directo" type="button" role="tab" aria-controls="panel_directo" aria-selected="true">Individual</button>
                      <button class="nav-link" id="panel_inverso_tab" data-bs-toggle="tab" data-bs-target="#panel_inverso" type="button" role="tab" aria-controls="panel_inverso" aria-selected="false">Archivo</button>
                  </div>
              </nav>
          </div>
      </div>

      <div class="tab-content" id="nav-tabContent">
          <div class="tab-pane fade show active" id="panel_directo" role="tabpanel" aria-labelledby="panel_directo_tab">
              <div class="container-fluid">
                  <div class="row mt-3">
                      <div class="col-md-6">
                          <div class="panel">
                              <div class="card-header">Época de Rastreo</div>
                              <div class="card-body">
                                  <input type="date" class="form-control" id="fechaRastreoPartida">
                              </div>
                          </div>
                      </div>
                      <div class="col-md-6">
                          <div class="panel">
                              <div class="card-header">Época de Referencia</div>
                              <div class="card-body">
                                  <input type="date" class="form-control" id="fechaReferenciaPartida">
                              </div>
                          </div>
                      </div>
                  </div>

                  <div class="container-fluid mt-3">
                      <div class="row">
                          <div class="col-md-6">
                              <div class="panel">
                                  <h6>Tipo de Coordenada</h6>
                                  <ul class="nav nav-tabs" id="myTab" role="tablist">
                                      <li class="nav-item" role="presentation">
                                          <button class="nav-link active" id="elipsoidaldecimal-tab" data-bs-toggle="tab" data-bs-target="#coordenadas-decimales" type="button" role="tab" aria-controls="elipsoidaldecimal" aria-selected="true">Elipsoidal Decimal</button>
                                      </li>
                                  </ul>

                                  <div class="tab-content mt-3">
                                      <div class="tab-pane fade show active" id="coordenadas-decimales" role="tabpanel">
                                          <input type="text" class="form-control" placeholder="Latitud (decimal)" id="latitud-decimal">
                                          <input type="text" class="form-control" placeholder="Longitud (decimal)" id="longitud-decimal">
                                      </div>
                                  </div>
                              </div>
                          </div>
                      </div>

                      <div class="row mt-3">
                          <div class="col-md-12 text-center">
                              <button class="btn btn-primary" id="calcular">Calcular</button>
                              <button class="btn btn-secondary" id="limpiar">Limpiar</button>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
      </div>
   
      <!-- Nuevo contenedor para los logs -->
      <div class="logs-container" id="logs">
        <h5>Proceso de Cambio de Época - Logs</h5>
        <div id="logsContent"></div>
      </div>
      
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="controller/Cambio_epoca.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
  <script>
    particlesJS('particles-js', {
      particles: {
        number: { value: 150 },
        color: { value: '#00d4ff' },
        shape: { type: 'circle' },
        opacity: { value: 0.5 },
        size: { value: 3 },
        line_linked: {
          enable: true,
          distance: 200,
          color: '#00d4ff',
          opacity: 0.4,
          width: 1
        },
        move: {
          enable: true,
          speed: 2
        }
      },
      interactivity: {
        events: {
          onhover: { enable: true, mode: 'grab' },
          onclick: { enable: true, mode: 'push' }
        },
        modes: {
          grab: { distance: 200, line_linked: { opacity: 1 } }
        }
      },
      retina_detect: true
    });
  </script>
</body>
</html>




