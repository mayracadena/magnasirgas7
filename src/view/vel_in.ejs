                <div class="tab-pane fade show active" id="elipsoidal-destino" role="tabpanel" aria-labelledby="elipsoidal-tab-destino">
                  <div class="form-group mt-3">
                    <label for="latitud-destino">Latitud:</label>
                    <div class="row">
                      <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="GG" id="latitud-grados-destino">
                      </div>
                      <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="MM" id="latitud-minutos-destino">
                      </div>
                      <div class="col-md-3">
                        <input type="text" class="form-control" placeholder="SS.DDDDD" id="latitud-segundos-destino">
                      </div>
                      <div class="col-md-3">
                        <select class="form-control" id="latitud-hemisferio-destino">
                          <option value="N">N</option>
                          <option value="S">S</option>
                        </select>
                      </div>
                    </div>
                  </div>
                  <!-- Resto del contenido tal cual -->
                  <!-- ... (No se muestra para abreviar) ... -->
                </div>
                <!-- Resto de las pestañas tal cual -->
                <!-- ... (No se muestra para abreviar) ... -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Botones de Acción -->
    <div class="row mt-3">
      <div class="col-md-12 text-center">
        <button class="btn btn-primary">Calcular</button>
        <button class="btn btn-secondary">Limpiar</button>
      </div>
    </div>
  </div>

  <!-- Panel Archivo -->
  <div class="tab-pane fade" id="panel_inverso" role="tabpanel" aria-labelledby="panel_inverso_tab">
    <div class="container-fluid">
      <!-- Fila para Época de Rastreo y Época de Referencia -->
      <div class="row mt-3">
        <!-- Columna para Época de Rastreo -->
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              Época de Rastreo
            </div>
            <div class="card-body">
              <div class="form-group">
                <input type="date" class="form-control" id="fechaRastreoArchivo">
              </div>
            </div>
          </div>
        </div>

        <!-- Columna para Época de Referencia -->
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              Época de Referencia
            </div>
            <div class="card-body">
              <div class="form-group">
                <input type="date" class="form-control" id="fechaReferenciaArchivo">
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Fila para Modelo de Velocidades y Módulo de Información -->
      <div class="row mt-3">
        <!-- Columna para Modelo de Velocidades -->
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              Modelo de Velocidades
            </div>
            <div class="card-body">
              <div class="form-group">
                <select class="form-control" id="modeloVelocidadesArchivo" onchange="mostrarInformacionVemosArchivo()">
                  <option value="vemos2022">VEMOS 2022</option>
                  <option value="vemos2017">VEMOS 2017</option>
                  <option value="vemos2015">VEMOS 2015</option>
                  <option value="vemos2009">VEMOS 2009</option>
                  <option value="vemos2003">VEMOS 2003</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Columna para el Módulo de Información -->
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              Información del Modelo de Velocidades
            </div>
            <div class="card-body">
              <div id="informacionVemosArchivo" class="form-group">
                <!-- La información del modelo seleccionado aparecerá aquí -->
                Cada modelo de velocidades es válido para un lapso de tiempo determinado
                <p></p>VEMOS 2022: Entre el 1 de febrero de 2017 y el 30 de abril de 2022.
                <p></p>VEMOS 2017: Entre el 1 de Enero de 2014 y el 28 de Enero de 2017
                <p></p>VEMOS 2015: Entre el 14 de marzo de 2010 y el 11 de abril de 2015.
                <p></p>VEMOS 2009: Entre el 2 de Enero de 2017 y el 30 de Junio de 2009.
                <p></p>VEMOS 2003: Anterior al 2000.
