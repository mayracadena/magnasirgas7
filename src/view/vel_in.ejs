              <div class="form-group">
                <select class="form-control" id="tipoCoordenadasArchivo" onchange="actualizarOpcionesAdicionales()">
                  <option value="geocentrica">Geocéntricas</option>
                  <option value="elipsoidal-sexagesimal">Elipsoidales Sexagesimales</option>
                  <option value="elipsoidal-decimal">Elipsoidales Decimales</option>
                  <option value="origen-nacional">Origen Nacional</option>
                  <option value="plana-cartesiana">Planas Cartesianas</option>
                  <option value="utm">UTM</option>
                  <option value="gauss-kruger">Gauss Krüger</option>
                </select>
              </div>
              <div class="form-group mt-2" id="opcionesAdicionales">
                <!-- Opciones adicionales según el tipo de coordenadas seleccionado aparecerán aquí -->
              </div>
            </div>
          </div>
        </div>
      </div>
      <p></p>
      <!-- Columna para Selección de Tipo de Coordenadas -->
        
            <!-- Botones de Acción -->
            <div class="row mt-3">
                <div class="col-md-12 text-center">
                <button class="btn btn-primary" onclick="procesarArchivo()">Procesar Archivo</button>
                <button class="btn btn-secondary" onclick="limpiarFormulario()">Limpiar</button>
                </div>
            </div>
            </div>
        </div>
        </div>

<!-- JavaScript para actualizar el módulo de información y opciones adicionales -->
<script>
  // Función para mostrar la información del modelo VEMOS seleccionado en el panel individual
  function mostrarInformacionVemos() {
    var seleccion = document.getElementById("modeloVelocidadesPartida").value;
    var informacionVemos = document.getElementById("informacionVemos");

    // Limpia el contenido actual
    informacionVemos.innerHTML = "";

    // Información según el modelo seleccionado
    if (seleccion === "vemos2022") {
      informacionVemos.innerHTML =
        '<p><strong>VEMOS 2022:</strong> Cubre el periodo comprendido entre el 1 de febrero de 2017 y el 30 de abril de 2022.</p>';
    } else if (seleccion === "vemos2017") {
      informacionVemos.innerHTML =
        '<p><strong>VEMOS 2017:</strong> Cubre la región comprendida entre 120°W, 55°S y 35°W, 32°N con una resolución espacial de 1° x 1°. La incertidumbre promedio es ±1.0 mm/a en la dirección norte-sur y ±1.7 mm/a en la dirección este-oeste.</p>';
    } else if (seleccion === "vemos2015") {
      informacionVemos.innerHTML =
        '<p><strong>VEMOS 2015:</strong> Válido del 14 de marzo de 2010 al 11 de abril del 2015. La incertidumbre media es ±0.6 mm/a en la dirección norte-sur y ±1.2 mm/a en la dirección este-oeste.</p>';
    } else if (seleccion === "vemos2009") {
      informacionVemos.innerHTML =
        '<p><strong>VEMOS 2009:</strong> Válido para el periodo entre enero 2 de 2000 y junio 30 de 2009. La incertidumbre media es aproximadamente 1.5 mm/a.</p>';
    } else if (seleccion === "vemos2003") {
      informacionVemos.innerHTML =
        '<p><strong>VEMOS 2003:</strong> Información específica del modelo VEMOS 2003.</p>';
    }
  }

  // Función para mostrar opciones adicionales según el tipo de coordenadas
  function actualizarOpcionesAdicionales() {
    var tipo = document.getElementById("tipoCoordenadasArchivo").value;
    var opcionesDiv = document.getElementById("opcionesAdicionales");
    opcionesDiv.innerHTML = "";

    if (tipo === "utm") {
      opcionesDiv.innerHTML = `
        <div class="form-group">
          <label for="huso">Huso:</label>
          <input type="text" class="form-control" id="huso">
        </div>
        <div class="form-group mt-2">
          <label for="hemisferio">Hemisferio:</label>
          <select class="form-control" id="hemisferio">
            <option value="N">Norte</option>
            <option value="S">Sur</option>
          </select>
        </div>
      `;
    } else if (tipo === "gauss-kruger") {
      opcionesDiv.innerHTML = `
        <div class="form-group mt-2">
          <label for="origen-gauss">Origen Gauss:</label>
          <select class="form-control" id="origen-gauss">
            <option value="Central">Central</option>
            <option value="Este">Este</option>
            <option value="Insular">Insular</option>
            <option value="Oeste">Oeste</option>
          </select>
        </div>
      `;
    } else {
      opcionesDiv.innerHTML = "";
    }
  }

  // Función para procesar el archivo CSV
  function procesarArchivo() {
    var archivoInput = document.getElementById("archivoCSV");
    var archivo = archivoInput.files[0];
    var delimitador = document.getElementById("delimitador").value;
    var tipoCoordenadas = document.getElementById("tipoCoordenadasArchivo").value;

    if (!archivo) {
      alert("Por favor, selecciona un archivo CSV.");
      return;
    }

    // Lógica para procesar el archivo CSV según el tipo de coordenadas seleccionado
    // Aquí puedes agregar el código necesario para leer el archivo y realizar los cálculos
  }

  // Función para limpiar el formulario
  function limpiarFormulario() {
    document.getElementById("fechaRastreoArchivo").value = "";
    document.getElementById("fechaReferenciaArchivo").value = "";
    document.getElementById("modeloVelocidadesArchivo").selectedIndex = 0;
    document.getElementById("archivoCSV").value = "";
    document.getElementById("tipoCoordenadasArchivo").selectedIndex = 0;
    document.getElementById("opcionesAdicionales").innerHTML = "";
    mostrarInformacionVemosArchivo();
  }

  // Eventos iniciales
  document.addEventListener("DOMContentLoaded", function() {
    mostrarInformacionVemos();
    mostrarInformacionVemosArchivo();
    actualizarOpcionesAdicionales();
  });

  document.getElementById("tipoCoordenadasArchivo").addEventListener("change", actualizarOpcionesAdicionales);
  document.getElementById("modeloVelocidadesArchivo").addEventListener("change", mostrarInformacionVemosArchivo);
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

