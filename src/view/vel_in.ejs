                </div>
            </nav>

        </div>
    </div>

<div class="tab-content" id="nav-tabContent">
  <!-- Panel Individual -->
  <div class="tab-pane fade show active" id="panel_directo" role="tabpanel" aria-labelledby="panel_directo_tab">
    <!-- Contenido original del procesamiento individual -->
    <div class="container-fluid">
      <!-- Fila para Época de Rastreo y Época de Referencia -->
