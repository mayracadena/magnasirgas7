                </li>
              </ul>
              <!-- Contenido de las pestañas -->
              <div class="tab-content" id="myTabContentPartida">
                <!-- Elipsoidal Sexagesimal -->
                <div class="tab-pane fade show active" id="elipsoidal-partida" role="tabpanel" aria-labelledby="elipsoidal-tab-partida">
                  <div class="form-group mt-3">
                    <label for="latitud-partida">Latitud:</label>
