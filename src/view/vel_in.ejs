            </div>
          </div>
        </div>
      </div>
      <div class="row mt-3"></div>
      <div class="col-md-6">
        <div class="card">
          <div class="card-header">
            Tipo de Coordenadas de Destino
          </div>
          <div class="card-body">
            <div class="form-group">
              <select class="form-control" id="tipoCoordenadasArchivo" onchange="actualizarOpcionesAdicionales()">
                <option value="geocentrica">Geocéntricas</option>
                <option value="elipsoidal-sexagesimal">Elipsoidales Sexagesimales</option>
                <option value="elipsoidal-decimal">Elipsoidales Decimales</option>
                <option value="origen-nacional">Origen Nacional</option>
                <option value="plana-cartesiana">Planas Cartesianas</option>
                <option value="utm">UTM</option>
                <option value="gauss-kruger">Gauss Krüger</option>
              </select>
            </div>
            <div class="form-group mt-2" id="opcionesAdicionales">
              <!-- Opciones adicionales según el tipo de coordenadas seleccionado aparecerán aquí -->
            </div>
          </div>
        </div>
      </div>
    </div>
        </div>
            <!-- Fila para Carga de Archivo CSV y Selección de Tipo de Coordenadas -->
            <div class="row mt-3">
                <!-- Columna para Carga de Archivo CSV -->
                <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                    Cargar Archivo CSV
                    </div>
                    <div class="card-body">
                    <div class="form-group">
                        <input type="file" class="form-control" id="archivoCSV" accept=".csv">
                    </div>
                    <div class="form-group mt-2">
                        <label for="delimitador">Delimitador:</label>
                        <select class="form-control" id="delimitador">
                        <option value=",">Coma (,)</option>
                        <option value=";">Punto y coma (;)</option>
                        <option value="tab">Tabulación</option>
                        </select>
                    </div>
                    </div>
                </div>
                </div>

        <!-- Columna para Selección de Tipo de Coordenadas -->
        
        <div class="col-md-6">
         <div class="tab-pane fade show active" id="panel_directo" role="tabpanel" aria-labelledby="panel_directo_tab">
          <div class="card">
            <div class="card-header">
              Tipo de Coordenadas en el Archivo
            </div>
