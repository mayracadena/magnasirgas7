<%- include('./partials/cabecero.ejs', {"titulo": "Cambio de epoca" }); %>
<%- include('./partials/menu.ejs'); %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cambio de Época</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Variables de raíz */
    :root {
      --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
      --primary-color: #00d4ff;
      --secondary-color: #001f3f;
      --secondary-hover-color: #0056b3;
      --text-color: #ffffff;
      --text-muted-color: rgba(255, 255, 255, 0.5);
      --bg-translucent: rgba(255, 255, 255, 0.05);
      --border-color-light: rgba(255, 255, 255, 0.1);
      --border-color-regular: rgba(255, 255, 255, 0.2);
      --focus-bg-color: rgba(255, 255, 255, 0.2);
      --form-control-bg-color: rgba(255, 255, 255, 0.1);
      --card-header-bg-color: rgba(0, 31, 63, 0.8);
      --btn-secondary-bg-color: #555555;
      --btn-secondary-hover-bg-color: #777777;
      --btn-secondary-text-color: #faffff;
    }

    /* Estilos globales */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--main-bg-color);
      color: var(--text-color);
      overflow: hidden;
      height: 100vh;
    }

    /* Fondo de partículas */
    #particles-js {
      position: absolute;
      width: 100%;
      height: 100%;
      z-index: -1;
    }

    .main-container {
      display: flex;
      width: 100vw;
      overflow: hidden;
    }

    /* Contenido principal */
    .main-content {
      flex: 1;
      display: flex;
      margin-left: 300px;
      flex-direction: column;
      max-height: 100vh;
      overflow-y: auto;
      padding: 20px;
      background: var(--bg-translucent);
    }

    /* Estilos de tarjeta */
    .card { 
      background: transparent;
      border: none;
    }

    .card-header {
      background: var(--card-header-bg-color);
      color: var(--primary-color);
      text-align: center;
      padding: 15px;
      border-bottom: 1px solid var(--border-color-regular);
    }

    .card-body {
      padding: 30px;
    }

    /* Estilos de formulario */
    .form-group label {
      font-weight: bold;
      color: var(--primary-color);
    }

    .form-control {
      background: var(--form-control-bg-color);
      border: 1px solid var(--border-color-regular);
      color: var(--text-color);
    }

    .form-control::placeholder {
      color: var(--text-muted-color);
    }

    .form-control:focus {
      background: var(--focus-bg-color);
      color: var(--text-color);
    }

    /* Botones */
    .btn {
      border: none;
      transition: background-color 0.3s, transform 0.3s;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-primary {
      background-color: var(--secondary-color);
      color: var(--primary-color);
    }

    .btn-primary:hover {
      background-color: var(--secondary-hover-color);
    }

    .btn-secondary {
      background-color: var(--btn-secondary-bg-color);
      color: var(--btn-secondary-text-color);
    }

    .btn-secondary:hover {
      background-color: var(--btn-secondary-hover-bg-color);
    }

    /* Paneles */
    .panel {
      background: var(--panel-bg-color);
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 10px;
      border: 1px solid var(--panel-border-color);
    }

    .panel h2,
    .panel h3 {
      margin-bottom: 20px;
      color: var(--primary-color);
    }

    /* Pestañas */
    .nav-tabs .nav-link {
      background: transparent;
      border: none;
      color: var(--primary-color);
      font-weight: bold;
      transition: color 0.3s, border-bottom 0.3s;
    }

    .nav-tabs .nav-link.active {
      color: #000000;
      border-bottom: 2px solid var(--primary-color);
    }

    .nav-tabs .nav-link:hover {
      color: var(--text-color);
    }

    /* Personalización de partículas */
    .particles-js-canvas-el {
      position: absolute;
      top: 0;
      left: 0;
    }

    /* Contenedor de resultados y modelos de velocidad */
    .resultados-container, .modelos-utilizados-container {
      background: var(--panel-bg-color);
      padding: 20px;
      margin-top: 20px;
      border: 1px solid var(--border-color-light);
      border-radius: 8px;
      color: var(--primary-color);
    }

    /* Consultas de medios */
    @media (max-width: 768px) {
      .row {
        flex-direction: column;
      }
      .row .col {
        margin-bottom: 15px;
      }
    }
  </style>
</head>
<body>
  <!-- Particles Background -->
  <div id="particles-js"></div>

  <div class="main-content">
      <div class="card shadow">
          <div class="card-header">
              <h2>Cambio de Época</h2>
          </div>
          <div class="card-body">
              <nav>
                  <div class="nav nav-tabs" id="nav-tab" role="tablist">
                      <button class="nav-link active" id="panel_directo_tab" data-bs-toggle="tab" data-bs-target="#panel_directo" type="button" role="tab" aria-controls="panel_directo" aria-selected="true">Individual</button>
                      <button class="nav-link" id="panel_inverso_tab" data-bs-toggle="tab" data-bs-target="#panel_inverso" type="button" role="tab" aria-controls="panel_inverso" aria-selected="false">Archivo</button>
                  </div>
              </nav>
          </div>
      </div>

      <div class="tab-content" id="nav-tabContent">
          <!-- Panel Individual -->
          <div class="tab-pane fade show active" id="panel_directo" role="tabpanel" aria-labelledby="panel_directo_tab">
              <div class="container-fluid">
                  <!-- Fila para Época de Rastreo y Época de Referencia -->
                  <div class="row mt-3">
                      <div class="col-md-6">
                          <div class="card">
                              <div class="card-header">Época de Rastreo</div>
                              <div class="card-body">
                                  <div class="form-group">
                                      <input type="date" class="form-control" id="fechaRastreoPartida">
                                  </div>
                              </div>
                          </div>
                      </div>
                      <div class="col-md-6">
                          <div class="card">
                              <div class="card-header">Época de Referencia</div>
                              <div class="card-body">
                                  <div class="form-group">
                                      <input type="date" class="form-control" id="fechaReferenciaPartida">
                                  </div>
                              </div>
                          </div>
                      </div>
                  </div>

                  <!-- Fila para Tipo de Coordenada de Partida y Destino -->
                  <div class="container-fluid">
                      <div class="row mt-3">
                          <div class="col-md-6">
                              <div class="panel">
                                  <h6>Tipo de Coordenada</h6>
                                  <ul class="nav nav-tabs" id="myTab" role="tablist">
                                      <li class="nav-item" role="presentation">
                                          <button class="nav-link active" id="elipsoidal-tab" data-bs-toggle="tab" data-bs-target="#elipsoidal" type="button" role="tab" aria-controls="elipsoidal" aria-selected="true">Elipsoidal Sexagesimal</button>
                                      </li>
                                      <li class="nav-item" role="presentation">
                                          <button class="nav-link" id="elipsoidaldecimal-tab" data-bs-toggle="tab" data-bs-target="#coordenadas-decimales" type="button" role="tab" aria-controls="elipsoidaldecimal" aria-selected="false">Elipsoidal Decimal</button>
                                      </li>
                                      <li class="nav-item" role="presentation">
                                          <button class="nav-link" id="geocentrica-tab" data-bs-toggle="tab" data-bs-target="#geocentrica" type="button" role="tab" aria-controls="geocentrica" aria-selected="false">Geocéntrica</button>
                                      </li>
                                  </ul>

                                  <div class="tab-content" id="myTabContent">
                                      <!-- Elipsoidal Tab Pane -->
                                      <div class="tab-pane fade show active" id="elipsoidal" role="tabpanel" aria-labelledby="elipsoidal-tab">
                                          <div class="form-group">
                                              <label for="latitud">Latitud:</label>
                                              <div class="row">
                                                  <div class="col-md-3"><input type="text" class="form-control" placeholder="GG" id="latitud-grados"></div>
                                                  <div class="col-md-3"><input type="text" class="form-control" placeholder="MM" id="latitud-minutos"></div>
                                                  <div class="col-md-3"><input type="text" class="form-control" placeholder="SS.DDDDD" id="latitud-segundos"></div>
                                                  <div class="col-md-3">
                                                      <select class="form-control" id="latitud-hemisferio">
                                                          <option value="N">N</option>
                                                          <option value="S">S</option>
                                                      </select>
                                                  </div>
                                              </div>
                                          </div>
                                          <div class="form-group">
                                              <label for="longitud">Longitud:</label>
                                              <div class="row">
                                                  <div class="col-md-3"><input type="text" class="form-control" placeholder="GG" id="longitud-grados"></div>
                                                  <div class="col-md-3"><input type="text" class="form-control" placeholder="MM" id="longitud-minutos"></div>
                                                  <div class="col-md-3"><input type="text" class="form-control" placeholder="SS.DDDDD" id="longitud-segundos"></div>
                                                  <div class="col-md-3">
                                                      <select class="form-control" id="longitud-hemisferio">
                                                          <option value="E">E</option>
                                                          <option value="W">W</option>
                                                      </select>
                                                  </div>
                                              </div>
                                          </div>
                                      </div>

                                      <!-- Elipsoidal Decimal Tab Pane -->
                                      <div class="tab-pane fade" id="coordenadas-decimales" role="tabpanel" aria-labelledby="elipsoidaldecimal-tab">
                                          <div class="form-group">
                                              <label for="latitud-decimal">Latitud (decimal):</label>
                                              <input type="text" class="form-control" placeholder="Latitud (decimal)" id="latitud-decimal">
                                          </div>
                                          <div class="form-group">
                                              <label for="longitud-decimal">Longitud (decimal):</label>
                                              <input type="text" class="form-control" placeholder="Longitud (decimal)" id="longitud-decimal">
                                          </div>
                                      </div>

                                      <!-- Geocéntrica Tab Pane -->
                                      <div class="tab-pane fade" id="geocentrica" role="tabpanel" aria-labelledby="geocentrica-tab">
                                          <div class="form-group">
                                              <label for="x">X (m):</label>
                                              <input type="text" class="form-control" id="coord-x">
                                          </div>
                                          <div class="form-group">
                                              <label for="y">Y (m):</label>
                                              <input type="text" class="form-control" id="coord-y">
                                          </div>
                                          <div class="form-group">
                                              <label for="z">Z (m):</label>
                                              <input type="text" class="form-control" id="coord-z">
                                          </div>
                                      </div>
                                  </div>
                              </div>
                          </div>
                      </div>

                      <!-- Botones de Acción -->
                      <div class="row mt-3">
                          <div class="col-md-12 text-center">
                              <button class="btn btn-primary" id="calcular">Calcular</button>
                              <button class="btn btn-secondary" id="limpiar">Limpiar</button>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
      </div>

      <!-- Contenedor de Resultados -->
      <div class="resultados-container" id="resultados">
          <h5>Coordenadas en la Nueva Época</h5>
          <p id="coordenadasResultado">Aquí se mostrarán las coordenadas en la nueva época basadas en el tipo de coordenada ingresado.</p>
      </div>

      <!-- Contenedor de Modelos Utilizados y Fechas -->
      <div class="modelos-utilizados-container" id="modelosUtilizados">
          <h5>Modelos de Velocidad Utilizados</h5>
          <p id="listaModelos">Lista de modelos y rangos de fechas utilizados se mostrarán aquí.</p>
      </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="controller/Cambio_epoca.js"></script>
  <!-- Particles.js Script -->
  <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
  <script>
    particlesJS('particles-js', {
      particles: {
        number: { value: 80 },
        color: { value: '#00d4ff' },
        shape: {
          type: 'circle',
          stroke: { width: 0, color: '#000000' },
          polygon: { nb_sides: 5 },
        },
        opacity: { value: 0.5 },
        size: { value: 3 },
        line_linked: {
          enable: true,
          distance: 150,
          color: '#00d4ff',
          opacity: 0.4,
          width: 1
        },
        move: {
          enable: true,
          speed: 2,
          direction: 'none',
          random: false,
          straight: false,
          out_mode: 'out',
          bounce: false,
        }
      },
      interactivity: {
        detect_on: 'canvas',
        events: {
          onhover: { enable: true, mode: 'grab' },
          onclick: { enable: true, mode: 'push' },
          resize: true
        },
        modes: {
          grab: { distance: 200, line_linked: { opacity: 1 } },
          bubble: { distance: 200, size: 40, duration: 2, opacity: 8 },
          repulse: { distance: 100 },
          push: { particles_nb: 4 },
          remove: { particles_nb: 2 }
        }
      },
      retina_detect: true
    });
  </script>
</body>
</html>



