                  <option value="vemos2017">VEMOS 2017</option>
                  <option value="vemos2015">VEMOS 2015</option>
                  <option value="vemos2009">VEMOS 2009</option>
                  <option value="vemos2003">VEMOS 2003</option>
                </select>
              </div>
            </div>
          </div>
        </div>
    
        <!-- Columna para el Módulo de Información -->
        <div class="col-md-6">
          <div class="card">
            <div class="card-header">
              Información del Modelo de Velocidades
            </div>
            <div class="card-body">
              <div id="informacionVemos" class="form-group">
