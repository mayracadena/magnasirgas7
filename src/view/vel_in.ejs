<%- include('./partials/cabecero.ejs', {"titulo": "Cambio de época" }); %>
<%- include('./partials/menu.ejs'); %>

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cambio de Época</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    /* Variables de raíz */
    :root {
      --main-bg-color: linear-gradient(135deg, #000000, #001f3f);
      --primary-color: #00d4ff;
      --secondary-color: #001f3f;
      --secondary-hover-color: #0056b3;
      --text-color: #ffffff;
      --text-muted-color: rgba(255, 255, 255, 0.5);
      --bg-translucent: rgba(255, 255, 255, 0.05);
      --border-color-light: rgba(255, 255, 255, 0.1);
      --border-color-regular: rgba(255, 255, 255, 0.2);
      --focus-bg-color: rgba(255, 255, 255, 0.2);
      --form-control-bg-color: rgba(255, 255, 255, 0.1);
      --card-header-bg-color: rgba(0, 31, 63, 0.8);
      --btn-secondary-bg-color: #555555;
      --btn-secondary-hover-bg-color: #777777;
      --panel-bg-color: rgba(255, 255, 255, 0.05);
      --panel-border-color: rgba(255, 255, 255, 0.1);
      --btn-secondary-text-color: #faffff;
    }
  
    /* Estilos globales */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--main-bg-color);
      color: var(--text-color);
      overflow: hidden;
      height: 100vh;
    }
  
    /* Fondo de partículas */
    #particles-js {
      position: absolute;
      width: 100%;
      height: 100%;
      z-index: -1;
    }
  .main-container {
    display: flex;
  
    width: 100vw; /* Ancho completo de la ventana */
    overflow: hidden; /* Evita que el contenedor principal tenga desplazamiento */
  }
  
  /* Barra lateral */
  .sidebar {
    width: 250px; /* Ajusta el ancho según tu diseño */
    background-color: #0056b3; /* Color de fondo de la barra lateral */
    overflow-y: auto; /* Agrega desplazamiento en la barra lateral si es necesario */
  }
  /* Contenido principal */
  .main-content {
    flex: 1; /* Ocupa el espacio restante a la derecha de la barra lateral */
    display: flex;
    margin-left: 300px;
    flex-direction: column;
    max-height: 100vh; /* Limita la altura del contenido principal a la ventana */
    overflow-y: auto; /* Permite el desplazamiento vertical si el contenido es mayor */
    padding: 20px;
    background: var(--bg-translucent);
  }
  
  
    /* Estilos de tarjeta */
    .card { 
      background: transparent;
      border: none;
    }
  
    .card-header {
      position: sticky;
      top: 0;
      width: 100%;
      background: var(--card-header-bg-color);
      color: var(--primary-color);
      text-align: center;
      z-index: 10;
      padding: 15px;
      border-bottom: 1px solid var(--border-color-regular);
    }
  
    .card-body {
      padding: 30px;
    }
  
    /* Estilos de formulario */
    .form-group label {
      font-weight: bold;
      color: var(--primary-color);
    }
  
    .form-control {
      background: var(--form-control-bg-color);
      border: 1px solid var(--border-color-regular);
      color: var(--text-color);
    }
  
    .form-control::placeholder {
      color: var(--text-muted-color);
    }
  
    .form-control:focus {
      background: var(--focus-bg-color);
      color: var(--text-color);
    }
  
    /* Botones */
    .btn {
      border: none;
      transition: background-color 0.3s, transform 0.3s;
    }
  
    .btn:hover {
      transform: translateY(-2px);
    }
  
    .btn-primary {
      background-color: var(--secondary-color);
      color: var(--primary-color);
    }
  
    .btn-primary:hover {
      background-color: var(--secondary-hover-color);
    }
  
    .btn-secondary {
      background-color: var(--btn-secondary-bg-color);
      color: var(--btn-secondary-text-color);
    }
  
    .btn-secondary:hover {
      background-color: var(--btn-secondary-hover-bg-color);
    }
  
    /* Paneles */
    .panel {
      background: var(--panel-bg-color);
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 10px;
      border: 1px solid var(--panel-border-color);
    }
  
    .panel h2,
    .panel h3 {
      margin-bottom: 20px;
      color: var(--primary-color);
    }
  
    /* Pestañas */
    .nav-tabs .nav-link {
      background: transparent;
      border: none;
      color: var(--primary-color);
      font-weight: bold;
      transition: color 0.3s, border-bottom 0.3s;
    }
  
    .nav-tabs .nav-link.active {
      color: #000000;
      border-bottom: 2px solid var(--primary-color);
    }
  
    .nav-tabs .nav-link:hover {
      color: var(--text-color);
    }
  
    /* Personalización de partículas */
    .particles-js-canvas-el {
      position: absolute;
      top: 0;
      left: 0;
    }
  
    /* Consultas de medios */
    @media (max-width: 768px) {
      .row {
        flex-direction: column;
      }
      .row .col {
        margin-bottom: 15px;
      }
    }
    .logs-container {
      background: rgba(0, 0, 0, 0.7); /* Fondo oscuro */
      border: 1px solid rgba(255, 255, 255, 0.2); /* Borde claro */
      padding: 20px;
      margin-top: 20px;
      border-radius: 8px;
      color: var(--primary-color);
      font-size: 1em;
      max-height: 300px; /* Altura máxima con scroll */
      overflow-y: auto; /* Permitir desplazamiento vertical */
    }
    
    .logs-container h5 {
      margin-bottom: 15px;
      color: var(--primary-color);
    }
    
    #logsContent p {
      margin: 0;
      padding: 5px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      font-family: 'Courier New', Courier, monospace;
      color: #ffffff;
    }
    
  </style>
  
</head>
<body>
  <div id="particles-js"></div>

  <div class="main-content">
      <div class="card shadow">
          <div class="card-header">
              <h2>Cambio de Época</h2>
          </div>
          <div class="card-body">
              <nav>
                  <div class="nav nav-tabs" id="nav-tab" role="tablist">
                      <button class="nav-link active" id="panel_directo_tab" data-bs-toggle="tab" data-bs-target="#panel_directo" type="button" role="tab" aria-controls="panel_directo" aria-selected="true">Individual</button>
                      <button class="nav-link" id="panel_inverso_tab" data-bs-toggle="tab" data-bs-target="#panel_inverso" type="button" role="tab" aria-controls="panel_inverso" aria-selected="false">Archivo</button>
                  </div>
              </nav>
          </div>
      </div>

      <div class="tab-content" id="nav-tabContent">
          <div class="tab-pane fade show active" id="panel_directo" role="tabpanel" aria-labelledby="panel_directo_tab">
              <div class="container-fluid">
                  <div class="row mt-3">
                      <div class="col-md-6">
                          <div class="card">
                              <div class="card-header">Época de Rastreo</div>
                              <div class="card-body">
                                  <input type="date" class="form-control" id="fechaRastreoPartida">
                              </div>
                          </div>
                      </div>
                      <div class="col-md-6">
                          <div class="card">
                              <div class="card-header">Época de Referencia</div>
                              <div class="card-body">
                                  <input type="date" class="form-control" id="fechaReferenciaPartida">
                              </div>
                          </div>
                      </div>
                  </div>

                  <div class="container-fluid mt-3">
                      <div class="row">
                          <div class="col-md-6">
                              <div class="panel">
                                  <h6>Tipo de Coordenada</h6>
                                  <ul class="nav nav-tabs" id="myTab" role="tablist">
                                      <li class="nav-item" role="presentation">
                                          <button class="nav-link active" id="elipsoidaldecimal-tab" data-bs-toggle="tab" data-bs-target="#coordenadas-decimales" type="button" role="tab" aria-controls="elipsoidaldecimal" aria-selected="true">Elipsoidal Decimal</button>
                                      </li>
                                  </ul>

                                  <div class="tab-content mt-3">
                                      <div class="tab-pane fade show active" id="coordenadas-decimales" role="tabpanel">
                                          <input type="text" class="form-control" placeholder="Latitud (decimal)" id="latitud-decimal">
                                          <input type="text" class="form-control" placeholder="Longitud (decimal)" id="longitud-decimal">
                                      </div>
                                  </div>
                              </div>
                          </div>
                      </div>

                      <div class="row mt-3">
                          <div class="col-md-12 text-center">
                              <button class="btn btn-primary" id="calcular">Calcular</button>
                              <button class="btn btn-secondary" id="limpiar">Limpiar</button>
                          </div>
                      </div>
                  </div>
              </div>
          </div>
      </div>
   
      <!-- Nuevo contenedor para los logs -->
      <div class="logs-container" id="logs">
        <h5>Proceso de Cambio de Época - Logs</h5>
        <div id="logsContent"></div>
      </div>
      
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="controller/Cambio_epoca.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
  <script>
    particlesJS('particles-js', {
      particles: {
        number: { value: 80 },
        color: { value: '#00d4ff' },
        shape: { type: 'circle' },
        opacity: { value: 0.5 },
        size: { value: 3 },
        line_linked: {
          enable: true,
          distance: 150,
          color: '#00d4ff',
          opacity: 0.4,
          width: 1
        },
        move: { enable: true, speed: 2 }
      },
      interactivity: {
        detect_on: 'canvas',
        events: {
          onhover: { enable: true, mode: 'grab' },
          onclick: { enable: true, mode: 'push' },
          resize: true
        }
      },
      retina_detect: true
    });
  </script>
</body>
</html>




