          <div class="card">
            <div class="card-header">
              Época de Referencia
            </div>
            <div class="card-body">
              <div class="form-group">
                <input type="date" class="form-control" id="fechaReferenciaPartida">
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p></p>
    <div class="container-fluid">
      <!-- Fila para Modelo de Velocidades y Módulo de Información -->
      <div class="row mt-3">
        <!-- Columna para Modelo de Velocidades -->
        <div class="col-md-6">
