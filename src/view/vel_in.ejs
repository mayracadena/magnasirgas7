                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="elipsoidal-decimal-tab-partida" data-bs-toggle="tab" data-bs-target="#elipsoidal-decimal-partida" type="button" role="tab" aria-controls="elipsoidal-decimal-partida" aria-selected="false">Elipsoidal Decimal</button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="origen-nacional-tab-partida" data-bs-toggle="tab" data-bs-target="#origen-nacional-partida" type="button" role="tab" aria-controls="origen-nacional-partida" aria-selected="false">Origen Nacional</button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" id="geocentrica-tab-partida" data-bs-toggle="tab" data-bs-target="#geocentrica-partida" type="button" role="tab" aria-controls="geocentrica-partida" aria-selected="false">Geocéntrica</button>
                </li>
