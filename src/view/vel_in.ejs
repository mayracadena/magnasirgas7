 <script>
// Función para mostrar la información del modelo VEMOS seleccionado
function mostrarInformacionVemos() {
    var seleccion = document.getElementById("modeloVelocidadesPartida").value;
    var informacionVemos = document.getElementById("informacionVemos");
  
    // Limpia el contenido actual
    informacionVemos.innerHTML = "";
  
    // Información según el modelo seleccionado
    if (seleccion === "vemos2022") {
      informacionVemos.innerHTML = 
        '<p><strong>VEMOS 2022:</strong> Cubre el periodo comprendido entre el 1 de febrero de 2017 y el 30 de abril de 2022.</p>';
    } else if (seleccion === "vemos2017") {
      informacionVemos.innerHTML = 
        '<p><strong>VEMOS 2017:</strong> Cubre la región comprendida entre 120°W, 55°S y 35°W, 32°N con una resolución espacial de 1° x 1°. La incertidumbre promedio es ±1.0 mm/a en la dirección norte-sur y ±1.7 mm/a en la dirección este-oeste.</p>';
    } else if (seleccion === "vemos2015") {
      informacionVemos.innerHTML = 
        '<p><strong>VEMOS 2015:</strong> Válido del 14 de marzo de 2010 al 11 de abril del 2015. La incertidumbre media es ±0.6 mm/a en la dirección norte-sur y ±1.2 mm/a en la dirección este-oeste.</p>';
    } else if (seleccion === "vemos2009") {
      informacionVemos.innerHTML = 
        '<p><strong>VEMOS 2009:</strong> Válido para el periodo entre enero 2 de 2000 y junio 30 de 2009. La incertidumbre media es aproximadamente 1.5 mm/a.</p>';
    }
  }
  
  // Ejecuta la función al cargar la página para mostrar la información del modelo por defecto
  document.addEventListener("DOMContentLoaded", function() {
    mostrarInformacionVemos();
  });
  </script>
  

